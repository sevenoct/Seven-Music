@@ -0,0 +1,356 @@
+//! The floating tab bar, after Mochy Music's Android navigation bar.
+//!
+//! A stadium of dark frosted glass hung above the player. One glyph per tab, outline
+//! when it is off and filled when it is lit, crossfading over 200 ms. One pill sits
+//! behind the lit tab and stretches from tab to tab: its front edge springs ahead of
+//! the back one, so it reaches for the new tab and settles into it instead of sliding
+//! over as a block. A press lifts the pill (it swells a little and brightens) and the
+//! glyph under the pointer squishes to 85%. Pressing and dragging sideways carries the
+//! pill along, and the tab it is let go on opens.
+//!
+//! Measured off Mochy's `AppNavigation.kt` and `NavPill.kt`: a 64 dp bar, the pill
+//! 8 dp in from its top, bottom and ends, 4 dp between neighbouring pills, glyphs at
+//! 22 (Home, Search) and 24 dp, unlit ones at 70%, the lit pill white at 10%, the glass
+//! 78% dark over the blurred cover with a 5% hairline and a faint shadow. The bar stands on the left
+//! edge as a floating rail; below the four tabs it carries the playlists, one cover each,
+//! the way Spotify's library rail does.
+
+use egui::{Rect, Sense, Ui, pos2, vec2};
+
+use super::{Action, App, LibTab, Page, glyphs, shell, widgets};
+use crate::theme;
+
+/// The rail's width.
+pub const W: f32 = 64.0;
+/// How far the rail floats from the window's left edge.
+const EDGE: f32 = 12.0;
+/// Where the rail starts from the top of the window: under the history chevrons.
+const TOP: f32 = 54.0;
+/// One tab's height.
+const SLOT: f32 = 52.0;
+/// How far the pill sits in from the rail's sides.
+const INSET: f32 = 7.0;
+/// Room between a pill and where its neighbour's would be.
+const GAP: f32 = 4.0;
+/// Half the gap is the rail's padding and half is inside each slot.
+const PAD: f32 = INSET - GAP / 2.0;
+/// The tabs' part of the rail.
+const TABS_H: f32 = SLOT * 4.0 + PAD * 2.0;
+/// The logo's cell, above Home.
+const LOGO_H: f32 = 58.0;
+/// Space between the rail and the player pill under it.
+const ABOVE_PLAYER: f32 = 8.0;
+/// One playlist's row and its cover.
+const ROW: f32 = 46.0;
+const COVER: f32 = 38.0;
+/// How far the page starts from the window's left: the rail, and air beside it.
+pub const PAGE_LEFT: i8 = (EDGE + W + 22.0) as i8;
+
+struct Tab {
+    name: &'static str,
+    off: &'static [u8],
+    on: &'static [u8],
+    size: f32,
+}
+
+const TABS: [Tab; 4] = [
+    Tab { name: "Home", off: glyphs::HOME, on: glyphs::HOME_FILLED, size: 22.0 },
+    Tab { name: "Search", off: glyphs::SEARCH, on: glyphs::SEARCH_FILLED, size: 22.0 },
+    Tab { name: "Library", off: glyphs::LIBRARY, on: glyphs::LIBRARY_FILLED, size: 24.0 },
+    Tab { name: "Settings", off: glyphs::SETTINGS, on: glyphs::SETTINGS_FILLED, size: 24.0 },
+];
+
+/// The tab the page on screen belongs to. A page no tab owns (an album, an artist)
+/// lights none, and the pill fades out where it was.
+pub fn lit_tab(page: &Page) -> Option<usize> {
+    match page {
+        Page::Home => Some(0),
+        Page::Search(_) => Some(1),
+        // New, Downloaded and Transfer were sidebar rows: they live under Library now.
+        Page::Library(_) | Page::Downloads | Page::New | Page::Transfer => Some(2),
+        Page::Settings => Some(3),
+        _ => None,
+    }
+}
+
+/// Opens a tab the way the sidebar's rows do.
+fn open(app: &mut App, i: usize) {
+    let page = match i {
+        0 => Page::Home,
+        1 => {
+            // Search lands with the caret in the box; already there, it brings the box back.
+            app.search_refocus = true;
+            if matches!(app.page, Page::Search(_)) {
+                return;
+            }
+            Page::Search(String::new())
+        }
+        2 => Page::Library(LibTab::Playlists),
+        _ => Page::Settings,
+    };
+    app.actions.push(Action::Go(page));
+}
+
+/// Draws the rail on the window's left edge, from under the chevrons down to the player.
+pub fn show(app: &mut App, ctx: &egui::Context) {
+    let screen = ctx.content_rect();
+    let top = screen.top() + TOP;
+    let bottom = screen.bottom() - app.bar_height() - ABOVE_PLAYER;
+    if bottom - top < TABS_H + LOGO_H {
+        return;
+    }
+    let at = pos2(screen.left() + EDGE, top);
+    let room = bottom - top;
+    egui::Area::new(egui::Id::new("tab-bar"))
+        .fixed_pos(at)
+        .order(egui::Order::Middle)
+        .show(ctx, |ui| bar(app, ui, room));
+    cards(app, ctx, pos2(at.x, bottom));
+}
+
+/// What sat at the foot of the sidebar: the update card and the transfer's progress.
+fn cards(app: &mut App, ctx: &egui::Context, bar_at: egui::Pos2) {
+    let ready = app.updater.as_ref().and_then(|u| match u.state() {
+        crate::update::State::Ready { version, .. } => Some(version),
+        _ => None,
+    });
+    let transferring = super::transfer::sidebar_visible(app, ctx.input(|i| i.time));
+    if ready.is_none() && !transferring {
+        return;
+    }
+    let mut restart = false;
+    egui::Area::new(egui::Id::new("tab-bar-cards"))
+        .order(egui::Order::Middle)
+        .pivot(egui::Align2::LEFT_BOTTOM)
+        .fixed_pos(pos2(bar_at.x + W + 12.0, bar_at.y))
+        .show(ctx, |ui| {
+            ui.set_width(230.0);
+            if transferring {
+                super::transfer::sidebar_card(app, ui, false, 1.0, 28.0);
+                ui.add_space(6.0);
+            }
+            if let Some(v) = &ready
+                && widgets::pill(ui, &format!("Restart to update to {v}"), None, true).clicked()
+            {
+                restart = true;
+            }
+        });
+    if restart {
+        app.restart_to_update(ctx);
+    }
+}
+
+/// The sidebar's other entries, as chips along the top of the Library's pages.
+pub fn library_chips(app: &mut App, ui: &mut Ui) {
+    let current = app.page.clone();
+    let items: [(&str, Page); 9] = [
+        ("Playlists", Page::Library(LibTab::Playlists)),
+        ("Favourite Songs", Page::Playlist(super::LIKED_MUSIC.to_owned())),
+        ("Songs", Page::Library(LibTab::History)),
+        ("Albums", Page::Library(LibTab::Albums)),
+        ("Artists", Page::Library(LibTab::Artists)),
+        ("Downloaded", Page::Downloads),
+        ("Uploads", Page::Library(LibTab::Uploads)),
+        ("New", Page::New),
+        ("Transfer", Page::Transfer),
+    ];
+    ui.add_space(2.0);
+    ui.horizontal_wrapped(|ui| {
+        for (label, page) in items {
+            let on = current == page;
+            if widgets::pill(ui, label, None, on).clicked() && !on {
+                app.actions.push(Action::Go(page));
+            }
+        }
+    });
+    ui.add_space(4.0);
+}
+
+/// The playlists to show on the rail, in the order the sidebar kept them.
+fn rail_playlists(app: &mut App) -> Vec<(String, String, Vec<crate::model::Thumb>)> {
+    use crate::model::Target;
+    if !app.logged_in {
+        return Vec::new();
+    }
+    // Playlists that appeared since the order was last changed join it at the end.
+    if let Some(l) = &app.library {
+        for c in &l.playlists {
+            if let Target::Playlist(id) = &c.target
+                && !app.playlist_order.contains(id)
+            {
+                app.playlist_order.push(id.clone());
+            }
+        }
+    }
+    let Some(list) = app.library.as_ref().map(|l| &l.playlists).or(app.sidebar_cache.as_ref()) else {
+        return Vec::new();
+    };
+    let mut out: Vec<(usize, String, String, Vec<crate::model::Thumb>)> = list
+        .iter()
+        .filter_map(|c| match &c.target {
+            Target::Playlist(id) if !matches!(id.as_str(), "LM" | "VLLM") && !app.hidden_playlists.contains(id) => {
+                let at = app.playlist_order.iter().position(|x| x == id).unwrap_or(usize::MAX);
+                Some((at, id.clone(), c.title.clone(), c.thumbs.clone()))
+            }
+            _ => None,
+        })
+        .collect();
+    out.sort_by_key(|(at, ..)| *at);
+    out.into_iter().map(|(_, id, t, th)| (id, t, th)).collect()
+}
+
+fn bar(app: &mut App, ui: &mut Ui, room: f32) {
+    let ctx = ui.ctx().clone();
+    let lists = rail_playlists(app);
+    // Favourite Songs leads the list; the rest follow.
+    let rows = lists.len() + usize::from(app.logged_in);
+    let list_h = rows as f32 * ROW;
+    let want = LOGO_H + if rows > 0 { TABS_H + 12.0 + list_h + PAD } else { TABS_H };
+    let h = want.min(room);
+    let (rect, _) = ui.allocate_exact_size(vec2(W, h), Sense::hover());
+    // The logo sits above Home; a tap on it goes home.
+    let logo = Rect::from_min_size(rect.min, vec2(W, LOGO_H));
+    let oy = rect.top() + LOGO_H;
+    let tabs = Rect::from_min_size(pos2(rect.left(), oy), vec2(W, TABS_H));
+    let resp = ui.interact(tabs, egui::Id::new("tab-bar-tabs"), Sense::click_and_drag()).on_hover_cursor(egui::CursorIcon::PointingHand);
+    let tab_at = |y: f32| ((y - oy - PAD) / SLOT).floor().clamp(0.0, 3.0) as usize;
+    let pointer = ui.input(|i| i.pointer.latest_pos());
+    let pressed = resp.is_pointer_button_down_on();
+    // The tab under a finger that is down on the rail: it is lit and carries the pill
+    // while the finger is down, wherever the page says it is.
+    let held = if pressed { pointer.map(|p| tab_at(p.y)) } else { None };
+    let lit = lit_tab(&app.page);
+
+    // Where the pill is headed. With no lit tab it stays where it was, and fades.
+    let rest_id = egui::Id::new("tab-bar-rest");
+    let rest: f32 = ctx.data(|d| d.get_temp(rest_id)).unwrap_or(0.0);
+    let target = held.or(lit).map_or(rest, |i| i as f32);
+    ctx.data_mut(|d| d.insert_temp(rest_id, target));
+
+    // Its front edge springs to the new tab faster than the back one.
+    let dir_id = egui::Id::new("tab-bar-dir");
+    let (prev, down): (f32, bool) = ctx.data(|d| d.get_temp(dir_id)).unwrap_or((target, true));
+    let down = if (target - prev).abs() > 0.01 { target > prev } else { down };
+    ctx.data_mut(|d| d.insert_temp(dir_id, (target, down)));
+    let (back_secs, front_secs) = (0.30, 0.14);
+    let (start_secs, end_secs) = if down { (back_secs, front_secs) } else { (front_secs, back_secs) };
+    let start = theme::anim(&ctx, "tab-bar-start", target, start_secs);
+    let end = theme::anim(&ctx, "tab-bar-end", target, end_secs);
+    let (start, end) = (start.min(end), start.max(end));
+    let shown = theme::anim_bool(&ctx, "tab-bar-shown", held.is_some() || lit.is_some(), 0.2);
+    let lift = theme::anim_bool(&ctx, "tab-bar-lift", pressed, 0.14);
+
+    // The glass: OLED black with a bright rim, and nothing behind or over it.
+    let radius = W / 2.0;
+    shell::chrome_glass(app, ui, rect, radius);
+
+    // The logo.
+    let logo_resp = ui.interact(logo, egui::Id::new("tab-bar-logo"), Sense::click()).on_hover_cursor(egui::CursorIcon::PointingHand);
+    let glow = theme::anim_bool(&ctx, "tab-bar-logo-h", logo_resp.hovered(), 0.15);
+    let mark_box = Rect::from_center_size(pos2(logo.center().x, logo.center().y + 3.0), vec2(44.0, 30.0));
+    shell::mark(ui, mark_box, egui::Color32::from_white_alpha((200.0 + 55.0 * glow) as u8));
+    if logo_resp.clicked() {
+        app.actions.push(Action::Go(Page::Home));
+    }
+
+    // The pill: it swells past its slot and brightens while a finger is on it.
+    let grow = lift * 3.0;
+    let y0 = oy + PAD + start * SLOT + GAP / 2.0;
+    let y1 = oy + PAD + (end + 1.0) * SLOT - GAP / 2.0;
+    let pill = Rect::from_min_max(
+        pos2(rect.left() + INSET - grow, y0 - grow),
+        pos2(rect.right() - INSET + grow, y1 + grow),
+    );
+    let pill_color = theme::with_alpha(theme::glass(0.12 * (1.0 + 0.7 * lift)), shown);
+    ui.painter().rect_filled(pill, pill.width() / 2.0, pill_color);
+    ui.painter().rect_stroke(pill, pill.width() / 2.0, egui::Stroke::new(1.0, theme::with_alpha(theme::glass(0.10), shown)), egui::StrokeKind::Inside);
+
+    // The glyphs: outline at 70% when off, filled at full when lit, one fading into the other.
+    let ink = theme::text();
+    for (i, tab) in TABS.iter().enumerate() {
+        let on = held.or(lit) == Some(i);
+        let lit_amount = theme::anim_bool(&ctx, ("tab-bar-lit", i), on, 0.2);
+        let squish = theme::anim_bool(&ctx, ("tab-bar-squish", i), held == Some(i), 0.1);
+        let size = tab.size * (1.0 - 0.15 * squish);
+        let centre = pos2(rect.center().x, oy + PAD + (i as f32 + 0.5) * SLOT);
+        glyphs::draw(ui, centre, size, tab.off, theme::with_alpha(ink, 0.7 * (1.0 - lit_amount)));
+        glyphs::draw(ui, centre, size, tab.on, theme::with_alpha(ink, lit_amount));
+    }
+
+    if let Some(p) = resp.hover_pos() {
+        let _ = resp.clone().on_hover_text(TABS[tab_at(p.y)].name);
+    }
+    // A tap opens the tab under it; a drag opens the one it is let go on.
+    if resp.clicked() || resp.drag_stopped() {
+        if let Some(p) = pointer {
+            open(app, tab_at(p.y));
+        }
+    }
+
+    // The playlists, under a hairline: Favourite Songs first, then one cover each.
+    if rows == 0 || h < LOGO_H + TABS_H + ROW {
+        return;
+    }
+    let line_y = oy + TABS_H + 2.0;
+    ui.painter().line_segment(
+        [pos2(rect.left() + 16.0, line_y), pos2(rect.right() - 16.0, line_y)],
+        egui::Stroke::new(1.0, theme::glass(0.10)),
+    );
+    let area = Rect::from_min_max(pos2(rect.left(), line_y + 6.0), pos2(rect.right(), rect.bottom() - PAD));
+    let mut hide: Option<String> = None;
+    let mut open_target: Option<Page> = None;
+    ui.scope_builder(egui::UiBuilder::new().max_rect(area), |ui| {
+        egui::ScrollArea::vertical()
+            .id_salt("rail-playlists")
+            .auto_shrink(false)
+            .scroll_bar_visibility(egui::scroll_area::ScrollBarVisibility::AlwaysHidden)
+            .show(ui, |ui| {
+                ui.spacing_mut().item_spacing.y = 0.0;
+                // Favourite Songs.
+                let liked = Page::Playlist(super::LIKED_MUSIC.to_owned());
+                let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click());
+                let resp = widgets::named(resp, "Favourite Songs").on_hover_text("Favourite Songs").on_hover_cursor(egui::CursorIcon::PointingHand);
+                let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER));
+                let sel = app.page == liked;
+                let h = theme::anim_bool(&ctx, "rail-liked-h", resp.hovered(), 0.15);
+                ui.painter().rect_filled(c, 11.0, theme::glass(0.16 + 0.10 * h));
+                glyphs::draw(ui, c.center(), 18.0, glyphs::STAR_FILLED, theme::text());
+                if sel {
+                    ui.painter().rect_stroke(c.expand(2.0), 13.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                }
+                if resp.clicked() {
+                    open_target = Some(liked);
+                }
+                for (id, title, thumbs) in &lists {
+                    let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click());
+                    if !ui.is_rect_visible(cell) {
+                        continue;
+                    }
+                    let resp = widgets::named(resp, title).on_hover_text(title).on_hover_cursor(egui::CursorIcon::PointingHand);
+                    let h = theme::anim_bool(&ctx, resp.id.with("h"), resp.hovered(), 0.15);
+                    let sel = app.page == Page::Playlist(id.clone());
+                    let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER)).expand(1.5 * h);
+                    widgets::paint_cover(ui, c, thumbs, 11.0, 1.0);
+                    if sel {
+                        ui.painter().rect_stroke(c.expand(2.0), 13.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                    }
+                    egui::Popup::context_menu(&resp).show(|ui| {
+                        ui.set_min_width(190.0);
+                        if ui.button("Hide from sidebar").clicked() {
+                            hide = Some(id.clone());
+                            ui.close();
+                        }
+                    });
+                    if resp.clicked() {
+                        open_target = Some(Page::Playlist(id.clone()));
+                    }
+                }
+            });
+    });
+    if let Some(id) = hide {
+        app.hidden_playlists.insert(id);
+    }
+    if let Some(Page::Playlist(id)) = open_target {
+        app.actions.push(Action::Open(crate::model::Target::Playlist(id)));
+    }
+}
