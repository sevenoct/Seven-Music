+/// The download's bar: a thin line that fills with the bytes that are here, and under it
+/// "12 MB of 40 MB" with the percentage. When the size isn't known, a short segment slides
+/// along the line and only the bytes so far are shown.
+fn download_bar(ui: &mut Ui, got: u64, total: u64, accent: Color32) {
+    let width = ui.available_width();
+    let (rect, _) = ui.allocate_exact_size(vec2(width, 4.0), egui::Sense::hover());
+    let track = if theme::light() { Color32::from_black_alpha(22) } else { Color32::from_white_alpha(26) };
+    let round = 2.0;
+    ui.painter().rect_filled(rect, round, track);
+    if total > 0 {
+        let want = (got as f32 / total as f32).clamp(0.0, 1.0);
+        // Eased, so the fill glides between the updates instead of jumping.
+        let frac = ui.ctx().animate_value_with_time(egui::Id::new("update-download-bar"), want, 0.3);
+        if frac > 0.0 {
+            let fill = Rect::from_min_size(rect.min, vec2((rect.width() * frac).max(4.0), rect.height()));
+            ui.painter().rect_filled(fill, round, accent);
+        }
+    } else {
+        let t = (ui.input(|i| i.time) * 0.8).fract() as f32;
+        let seg = rect.width() * 0.3;
+        let x0 = rect.left() + (rect.width() + seg) * t - seg;
+        let part = Rect::from_x_y_ranges(x0.max(rect.left())..=(x0 + seg).min(rect.right()), rect.y_range());
+        if part.width() > 0.0 {
+            ui.painter().rect_filled(part, round, accent);
+        }
+        ui.ctx().request_repaint();
+    }
+    ui.add_space(8.0);
+    let amount = if total > 0 { format!("{} of {}", crate::cache::fmt(got), crate::cache::fmt(total)) } else { crate::cache::fmt(got) };
+    ui.horizontal(|ui| {
+        ui.label(egui::RichText::new(amount).font(theme::regular(12.5)).color(theme::text_dim()));
+        if total > 0 {
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                let percent = (got * 100 / total).min(100);
+                ui.label(egui::RichText::new(format!("{percent}%")).font(theme::semibold(12.5)).color(theme::text_dim()));
+            });
+        }
+    });
+}
