+
+// ------------------------------------------------------------------ local (this device)
+
+/// Songs found on this device by scanning its music folders, as the Local page lists them.
+static LOCAL: LazyLock<RwLock<Arc<Vec<Track>>>> = LazyLock::new(|| RwLock::new(Arc::new(Vec::new())));
+static LOCAL_LOADED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static SCANNING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static SCANNED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// A scan is running right now.
+pub fn scanning() -> bool {
+    SCANNING.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// A scan has finished since the app started.
+pub fn scanned() -> bool {
+    SCANNED.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// The songs the device scan found, by artist then title. Cheap: it is the list the last
+/// scan (or the saved index, the first time) built.
+pub fn local_songs() -> Arc<Vec<Track>> {
+    if !LOCAL_LOADED.swap(true, std::sync::atomic::Ordering::Relaxed) {
+        rebuild_local();
+    }
+    LOCAL.read().unwrap().clone()
+}
+
+fn rebuild_local() {
+    let mut songs: Vec<Track> = {
+        let st = STATE.read().unwrap();
+        st.index.values().filter(|e| e.device && e.path.is_file()).filter_map(|e| e.song.clone()).collect()
+    };
+    songs.sort_by_key(|t| (t.artist_line().to_lowercase(), t.title.to_lowercase()));
+    *LOCAL.write().unwrap() = Arc::new(songs);
+}
+
+/// Look through the device's music folders (Music, Downloads and the downloads folder)
+/// for songs, in the background; the Local page fills as it finishes.
+pub fn scan_device(ctx: &egui::Context) {
+    use std::sync::atomic::Ordering::Relaxed;
+    if SCANNING.swap(true, Relaxed) {
+        return;
+    }
+    let ctx = ctx.clone();
+    std::thread::spawn(move || {
+        let found = scan_device_now();
+        log::info!("local scan: {found} new songs");
+        rebuild_local();
+        LOCAL_LOADED.store(true, Relaxed);
+        SCANNED.store(true, Relaxed);
+        SCANNING.store(false, Relaxed);
+        ctx.request_repaint();
+    });
+}
+
+fn is_audio(path: &Path) -> bool {
+    let ext = path.extension().and_then(|e| e.to_str()).unwrap_or("").to_ascii_lowercase();
+    matches!(ext.as_str(), "mp3" | "flac" | "m4a" | "opus" | "ogg" | "wav" | "aac")
+}
+
+/// What a file says about itself.
+#[derive(Default)]
+struct Tags {
+    title: Option<String>,
+    artist: Option<String>,
+    album: Option<String>,
+    duration_ms: u64,
+}
+
+fn read_tags(path: &Path) -> Tags {
+    use symphonia::core::formats::FormatOptions;
+    use symphonia::core::io::MediaSourceStream;
+    use symphonia::core::meta::{MetadataOptions, StandardTagKey};
+    use symphonia::core::probe::Hint;
+
+    let mut out = Tags::default();
+    let ext = path.extension().and_then(|e| e.to_str()).unwrap_or("").to_ascii_lowercase();
+    if ext == "m4a" {
+        if let Ok(tag) = mp4ameta::Tag::read_from_path(path) {
+            out.title = tag.title().map(str::to_owned);
+            out.artist = tag.artist().map(str::to_owned);
+            out.album = tag.album().map(str::to_owned);
+            out.duration_ms = tag.duration().as_millis() as u64;
+        }
+        return out;
+    }
+    let Ok(file) = std::fs::File::open(path) else { return out };
+    let mss = MediaSourceStream::new(Box::new(file), Default::default());
+    let mut hint = Hint::new();
+    hint.with_extension(&ext);
+    let Ok(mut probed) = symphonia::default::get_probe().format(&hint, mss, &FormatOptions::default(), &MetadataOptions::default()) else {
+        return out;
+    };
+    let mut take = |tags: &[symphonia::core::meta::Tag]| {
+        for t in tags {
+            let value = t.value.to_string();
+            if value.trim().is_empty() {
+                continue;
+            }
+            match t.std_key {
+                Some(StandardTagKey::TrackTitle) if out.title.is_none() => out.title = Some(value),
+                Some(StandardTagKey::Artist) if out.artist.is_none() => out.artist = Some(value),
+                Some(StandardTagKey::Album) if out.album.is_none() => out.album = Some(value),
+                _ => {}
+            }
+        }
+    };
+    if let Some(meta) = probed.metadata.get()
+        && let Some(rev) = meta.current()
+    {
+        take(rev.tags());
+    }
+    if let Some(rev) = probed.format.metadata().current() {
+        take(rev.tags());
+    }
+    if let Some(track) = probed.format.default_track() {
+        let p = &track.codec_params;
+        if let (Some(frames), Some(rate)) = (p.n_frames, p.sample_rate)
+            && rate > 0
+        {
+            out.duration_ms = frames * 1000 / u64::from(rate);
+        }
+    }
+    out
+}
+
+fn scan_device_now() -> usize {
+    use std::hash::{Hash, Hasher};
+
+    let mut roots: Vec<PathBuf> = Vec::new();
+    if let Some(u) = directories::UserDirs::new() {
+        roots.extend(u.audio_dir().map(Path::to_path_buf));
+        roots.extend(u.download_dir().map(Path::to_path_buf));
+    }
+    roots.push(folder());
+    roots.sort();
+    roots.dedup();
+
+    let known: std::collections::HashSet<PathBuf> = STATE.read().unwrap().index.values().map(|e| e.path.clone()).collect();
+    let mut seen: std::collections::HashSet<PathBuf> = std::collections::HashSet::new();
+    let mut fresh: Vec<(String, Entry)> = Vec::new();
+
+    let mut stack: Vec<(PathBuf, u8)> = roots.into_iter().filter(|r| r.is_dir()).map(|r| (r, 0)).collect();
+    while let Some((dir, depth)) = stack.pop() {
+        let Ok(read) = std::fs::read_dir(&dir) else { continue };
+        for entry in read.flatten() {
+            let path = entry.path();
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            if name.starts_with('.') {
+                continue;
+            }
+            let Ok(kind) = entry.file_type() else { continue };
+            if kind.is_dir() {
+                if depth < 8 {
+                    stack.push((path, depth + 1));
+                }
+                continue;
+            }
+            // Short sounds (alerts, samples) aren't songs.
+            let big_enough = entry.metadata().map(|m| m.len() >= 200_000).unwrap_or(false);
+            if !kind.is_file() || !is_audio(&path) || !big_enough || known.contains(&path) || !seen.insert(path.clone()) {
+                continue;
+            }
+            let tags = read_tags(&path);
+            let stem = path.file_stem().and_then(|s| s.to_str()).unwrap_or("Unknown");
+            let (guess_artist, guess_title) = match stem.split_once(" - ") {
+                Some((a, t)) => (a.trim().to_owned(), t.trim().to_owned()),
+                None => ("Unknown artist".to_owned(), stem.trim().to_owned()),
+            };
+            let mut hasher = std::collections::hash_map::DefaultHasher::new();
+            path.to_string_lossy().hash(&mut hasher);
+            let id = format!("local:{:016x}", hasher.finish());
+            let track = Track {
+                id: id.clone(),
+                title: tags.title.unwrap_or(guess_title),
+                artists: vec![crate::model::Link { name: tags.artist.unwrap_or(guess_artist), id: None }],
+                album: tags.album.map(|name| crate::model::Link { name, id: None }),
+                duration: (tags.duration_ms > 0).then_some((tags.duration_ms / 1000) as u32),
+                thumbs: Vec::new(),
+                track_nr: None,
+                plays: None,
+                music_video: false,
+                episode: false,
+            };
+            fresh.push((id, Entry { path, duration_ms: tags.duration_ms, loudness_db: None, stands_for: None, song: Some(track), device: true }));
+        }
+    }
+
+    let count = fresh.len();
+    if count > 0 {
+        let mut st = STATE.write().unwrap();
+        for (id, e) in fresh {
+            st.index.entry(id).or_insert(e);
+        }
+        if let Ok(json) = serde_json::to_vec(&st.index) {
+            let _ = std::fs::write(&st.file, json);
+        }
+    }
+    count
+}
