+                || i.pointer.any_down()
+                || i.smooth_scroll_delta != egui::Vec2::ZERO
+                || i.events.iter().any(|e| matches!(e, egui::Event::Key { .. } | egui::Event::PointerButton { .. } | egui::Event::Text(_) | egui::Event::MouseWheel { .. }))
+        });
+        let (focused, minimized) = ctx.input(|i| (i.focused, i.viewport().minimized == Some(true)));
+        let blocked = self.np_open
+            || self.idle_open == 0
+            || self.current().is_none()
+            || !self.playing()
+            || self.window.hidden()
+            || self.mini.busy()
+            || self.fullscreen
+            || self.jam_open
+            || !focused
+            || minimized
+            || ctx.egui_wants_keyboard_input();
+        if active || blocked {
+            ctx.data_mut(|d| d.insert_temp(id, now));
+            return;
+        }
+        let left = f64::from(self.idle_open) - (now - last);
+        if left <= 0.0 {
+            self.np_open = true;
+            ctx.data_mut(|d| d.insert_temp(id, now));
