diff --git a/src/ui/offline.rs b/src/ui/offline.rs
new file mode 100644
index 0000000..93d9cac
--- /dev/null
+++ b/src/ui/offline.rs
@@ -0,0 +1,242 @@
+//! The offline notice.
+//!
+//! A small thread tries to reach the internet every few seconds. When it cannot, a black-glass
+//! notice slides in from the top of the window ("You're offline") with two ways out: the music
+//! downloaded in the app, and the music found on this device. It stays until it is closed or the
+//! connection is back (a green "You're back online" notice then shows for a few seconds); losing the connection again brings it back. It also stays out of the way
+//! on those two pages, where there is nothing left to suggest.
+
+use std::net::{SocketAddr, TcpStream, ToSocketAddrs};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+
+use egui::{Align2, Color32, Context, Rect, Sense, pos2, vec2};
+
+use super::{Action, App, Page};
+use crate::theme;
+
+/// The watcher: its verdict (shared with the thread) and what the notice has done about it.
+pub struct Net {
+    online: Arc<AtomicBool>,
+    /// The notice was closed (or answered) during this outage.
+    dismissed: bool,
+    /// Offline at the last look, to notice the way back.
+    was_offline: bool,
+    /// When the connection came back (seconds of UI time): the green notice shows for a few seconds.
+    online_at: Option<f64>,
+    /// The outage began while a streamed song played, and the downloads took over.
+    switched: bool,
+    /// How many downloaded songs there were when the connection dropped.
+    downloads: usize,
+}
+
+impl Net {
+    fn start(ctx: Context) -> Self {
+        let online = Arc::new(AtomicBool::new(true));
+        let flag = online.clone();
+        let _ = std::thread::Builder::new().name("net-watch".into()).spawn(move || {
+            let mut misses = 0u32;
+            loop {
+                let up = reachable();
+                // Two misses in a row make it official; one hit is enough to be back.
+                misses = if up { 0 } else { misses + 1 };
+                let verdict = misses < 2;
+                if flag.swap(verdict, Ordering::Relaxed) != verdict {
+                    ctx.request_repaint();
+                }
+                std::thread::sleep(Duration::from_secs(if up { 5 } else { 1 }));
+            }
+        });
+        Self { online, dismissed: false, was_offline: false, online_at: None, switched: false, downloads: 0 }
+    }
+}
+
+/// Whether anything outside answers: a few public addresses (no name lookup needed), then the
+/// service the app lives on.
+fn reachable() -> bool {
+    const IPS: [&str; 3] = ["1.1.1.1:443", "8.8.8.8:443", "9.9.9.9:443"];
+    let timeout = Duration::from_millis(1200);
+    for a in IPS {
+        if let Ok(addr) = a.parse::<SocketAddr>()
+            && TcpStream::connect_timeout(&addr, timeout).is_ok()
+        {
+            return true;
+        }
+    }
+    "music.youtube.com:443"
+        .to_socket_addrs()
+        .ok()
+        .and_then(|mut it| it.next())
+        .is_some_and(|a| TcpStream::connect_timeout(&a, timeout).is_ok())
+}
+
+/// Called once a frame: starts the watcher the first time, and draws the notice while offline.
+pub fn show(app: &mut App, ctx: &Context, _now: f64) {
+    let mut back_online = false;
+    let mut went_offline = false;
+    let (offline, dismissed) = {
+        let net = app.net.get_or_insert_with(|| Net::start(ctx.clone()));
+        let offline = !net.online.load(Ordering::Relaxed);
+        if offline != net.was_offline {
+            net.was_offline = offline;
+            net.dismissed = false;
+            back_online = !offline;
+            went_offline = offline;
+            if !offline {
+                net.switched = false;
+            }
+            net.online_at = if back_online { Some(ctx.input(|i| i.time)) } else { None };
+        }
+        (offline, net.dismissed)
+    };
+    let _ = back_online;
+    if went_offline {
+        switch_to_downloads(app);
+    }
+    back_online_card(app, ctx);
+    let here = matches!(app.page, Page::Downloads | Page::Local);
+    let t = theme::anim_bool(ctx, "offline-notice", offline && !dismissed && !here, 0.28);
+    if t <= 0.0 {
+        return;
+    }
+
+    let screen = ctx.content_rect();
+    let w = (screen.width() - 32.0).clamp(380.0, 520.0);
+    let h = 184.0;
+    let (switched, downloads) = app.net.as_ref().map_or((false, 0), |n| (n.switched, n.downloads));
+    let at = pos2(screen.center().x - w / 2.0, screen.top() + 54.0 - (1.0 - t) * 18.0);
+    let mut go: Option<Page> = None;
+    let mut play = false;
+    let mut close = false;
+    egui::Area::new(egui::Id::new("offline-notice"))
+        .order(egui::Order::Foreground)
+        .fixed_pos(at)
+        .show(ctx, |ui| {
+            ui.multiply_opacity(t);
+            let (rect, _) = ui.allocate_exact_size(vec2(w, h), Sense::hover());
+            let p = ui.painter().clone();
+            p.rect_filled(rect, 24.0, Color32::from_black_alpha(232));
+            p.rect_stroke(rect, 24.0, egui::Stroke::new(1.0, Color32::from_white_alpha(22)), egui::StrokeKind::Inside);
+
+            // Title, with a small amber dot, and what is still possible.
+            p.circle_filled(pos2(rect.left() + 30.0, rect.top() + 34.0), 6.0, Color32::from_rgb(255, 69, 58));
+            p.text(pos2(rect.left() + 48.0, rect.top() + 34.0), Align2::LEFT_CENTER, "You're offline", theme::bold(20.0), Color32::WHITE);
+            let body = if switched {
+                "No internet connection. Playing your downloaded songs instead; the music on this device is here too."
+            } else {
+                "No internet connection. You can still play your downloads and the music on this device."
+            };
+            let galley = p.layout(body.to_owned(), theme::regular(14.5), theme::text_dim(), w - 64.0);
+            p.galley(pos2(rect.left() + 30.0, rect.top() + 60.0), galley, theme::text_dim());
+
+            // Close.
+            let x = Rect::from_center_size(pos2(rect.right() - 28.0, rect.top() + 34.0), vec2(32.0, 32.0));
+            let xr = ui.interact(x, egui::Id::new("offline-close"), Sense::click()).on_hover_cursor(egui::CursorIcon::PointingHand);
+            let xc = if xr.hovered() { Color32::WHITE } else { Color32::from_white_alpha(130) };
+            let c = x.center();
+            p.line_segment([c + vec2(-4.5, -4.5), c + vec2(4.5, 4.5)], egui::Stroke::new(1.6, xc));
+            p.line_segment([c + vec2(-4.5, 4.5), c + vec2(4.5, -4.5)], egui::Stroke::new(1.6, xc));
+            if xr.clicked() {
+                close = true;
+            }
+
+            // The two ways out.
+            let mut bx = rect.left() + 24.0;
+            // With downloads on the device the first button plays them; without, it opens the page.
+            let ways: [(&str, Option<Page>, f32); 2] = if downloads > 0 {
+                [("Play downloads", None, 184.0), ("Local music", Some(Page::Local), 144.0)]
+            } else {
+                [("Downloaded music", Some(Page::Downloads), 184.0), ("Local music", Some(Page::Local), 144.0)]
+            };
+            for (label, page, bw) in ways {
+                let r = Rect::from_min_size(pos2(bx, rect.bottom() - 22.0 - 42.0), vec2(bw, 42.0));
+                bx += bw + 12.0;
+                let resp = ui.interact(r, egui::Id::new(("offline-go", label)), Sense::click()).on_hover_cursor(egui::CursorIcon::PointingHand);
+                let hv = theme::anim_bool(ctx, resp.id.with("h"), resp.hovered(), 0.15);
+                p.rect_filled(r, 21.0, Color32::from_white_alpha((30.0 + 34.0 * hv) as u8));
+                p.text(r.center(), Align2::CENTER_CENTER, label, theme::semibold(15.0), Color32::WHITE);
+                if resp.clicked() {
+                    match page {
+                        Some(page) => go = Some(page),
+                        None => play = true,
+                    }
+                }
+            }
+        });
+
+    if play {
+        let songs = crate::downloads::list();
+        if !songs.is_empty() {
+            app.actions.push(Action::Play(songs, 0));
+        }
+        close = true;
+    }
+    if let Some(page) = go {
+        // Out of the player first, if it is up: the pages sit under it.
+        if app.np_open {
+            app.actions.push(Action::OpenNowPlaying(false));
+        }
+        app.actions.push(Action::Go(page));
+        close = true;
+    }
+    if close && let Some(n) = app.net.as_mut() {
+        n.dismissed = true;
+    }
+}
+
+/// The green notice that follows an outage: "You're back online", shown for a few seconds.
+fn back_online_card(app: &App, ctx: &Context) {
+    const SHOWN_FOR: f64 = 4.0;
+    let now = ctx.input(|i| i.time);
+    let live = app.net.as_ref().and_then(|n| n.online_at).is_some_and(|t0| now - t0 < SHOWN_FOR);
+    let t = theme::anim_bool(ctx, "online-notice", live, 0.28);
+    if live {
+        ctx.request_repaint_after(Duration::from_millis(250));
+    }
+    if t <= 0.0 {
+        return;
+    }
+    let screen = ctx.content_rect();
+    let w = (screen.width() - 32.0).clamp(300.0, 420.0);
+    let h = 88.0;
+    let at = pos2(screen.center().x - w / 2.0, screen.top() + 54.0 - (1.0 - t) * 18.0);
+    egui::Area::new(egui::Id::new("online-notice"))
+        .order(egui::Order::Foreground)
+        .fixed_pos(at)
+        .interactable(false)
+        .show(ctx, |ui| {
+            ui.multiply_opacity(t);
+            let (rect, _) = ui.allocate_exact_size(vec2(w, h), Sense::hover());
+            let p = ui.painter().clone();
+            p.rect_filled(rect, 24.0, Color32::from_black_alpha(232));
+            p.rect_stroke(rect, 24.0, egui::Stroke::new(1.0, Color32::from_white_alpha(22)), egui::StrokeKind::Inside);
+
+            // A green disc with a white tick.
+            let c = pos2(rect.left() + 42.0, rect.center().y);
+            p.circle_filled(c, 15.0, Color32::from_rgb(48, 209, 88));
+            let tick = egui::Stroke::new(2.4, Color32::WHITE);
+            p.line_segment([c + vec2(-6.0, 0.5), c + vec2(-1.8, 4.8)], tick);
+            p.line_segment([c + vec2(-1.8, 4.8), c + vec2(6.5, -4.5)], tick);
+
+            p.text(pos2(rect.left() + 72.0, rect.center().y - 12.0), Align2::LEFT_CENTER, "You're back online", theme::bold(20.0), Color32::WHITE);
+            p.text(pos2(rect.left() + 72.0, rect.center().y + 13.0), Align2::LEFT_CENTER, "Your connection is working again.", theme::regular(14.5), theme::text_dim());
+        });
+}
+
+/// The connection dropped while a streamed song was playing: carry on with the downloaded
+/// songs instead of letting the music die once the buffer runs out. A song that already plays
+/// from a file, or a paused player, is left alone.
+fn switch_to_downloads(app: &mut App) {
+    let songs = crate::downloads::list();
+    let count = songs.len();
+    let streaming = app.current().is_some_and(|t| crate::downloads::path(&t.id).is_none());
+    let take_over = app.playing() && streaming && count > 0;
+    if take_over {
+        app.actions.push(Action::Play(songs, 0));
+    }
+    if let Some(n) = app.net.as_mut() {
+        n.downloads = count;
+        n.switched = take_over;
+    }
+}
