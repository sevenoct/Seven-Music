+/// What `settle_after_window_change` compares from one frame to the next: focused,
+/// minimized, maximized, and the inner size in whole points.
+type WindowState = (bool, bool, bool, Option<(i32, i32)>);
+
+/// A window that was covered (Start menu, Alt-Tab, Win+Tab), refocused, restored from
+/// minimized or resized can come back showing a stale or black frame. The app idles at
+/// zero repaints, so nothing draws over that frame until something else (a hover, a
+/// playback tick) happens to. On any of those changes this asks for a short run of
+/// frames instead, so the surface is repainted a few times while it settles. Not while
+/// minimized: there is nothing on screen to repaint.
+fn settle_after_window_change(ctx: &egui::Context, now: f64) {
+    /// How long, in seconds, the follow-up frames run after a change.
+    const RUN: f64 = 0.6;
+    let state: WindowState = ctx.input(|i| {
+        let v = i.viewport();
+        (
+            i.focused,
+            v.minimized == Some(true),
+            v.maximized == Some(true),
+            v.inner_rect.map(|r| (r.width().round() as i32, r.height().round() as i32)),
+        )
+    });
+    let state_id = egui::Id::unique("window-settle-state");
+    let until_id = egui::Id::unique("window-settle-until");
+    let last = ctx.data(|d| d.get_temp::<WindowState>(state_id));
+    let mut until = ctx.data(|d| d.get_temp::<f64>(until_id)).unwrap_or(0.0);
+    if last.is_some_and(|l| l != state) && !state.1 {
+        until = now + RUN;
+        ctx.data_mut(|d| d.insert_temp(until_id, until));
+        ctx.request_repaint();
+    }
+    ctx.data_mut(|d| d.insert_temp(state_id, state));
+    if now < until {
+        ctx.request_repaint_after(Duration::from_millis(50));
+    }
+}
