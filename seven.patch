+#[derive(Clone, Copy, PartialEq)]
+enum DeviceKind {
+    Speaker,
+    Headset,
+    Display,
+}
+
+/// What kind of device an output's name describes, and whether it is Bluetooth.
+fn device_kind(name: &str) -> (DeviceKind, bool) {
+    let n = name.to_lowercase();
+    let has = |keys: &[&str]| keys.iter().any(|k| n.contains(k));
+    let bluetooth = has(&["bluetooth", "hands-free", "handsfree", "airpods", "buds", "wh-1000", "wf-1000", "(bt", " bt "]);
+    let kind = if has(&["headphone", "headset", "earphone", "earbud", "airpods", "buds", "hands-free", "handsfree", "wh-1000", "wf-1000"]) {
+        DeviceKind::Headset
+    } else if has(&["hdmi", "displayport", "display", "monitor", " tv", "(tv"]) && !has(&["speaker"]) {
+        DeviceKind::Display
+    } else {
+        DeviceKind::Speaker
+    };
+    (kind, bluetooth)
+}
+
+/// The Bluetooth rune, drawn as a line, centred on `c` and `s` tall.
+fn bluetooth_mark(ui: &Ui, c: egui::Pos2, s: f32, ink: Color32) {
+    let (u, v) = (s * 0.5, s * 0.5);
+    let p = |x: f32, y: f32| pos2(c.x + x * u * 0.62, c.y + y * v);
+    let pts = vec![p(-0.8, -0.5), p(0.8, 0.5), p(0.0, 1.0), p(0.0, -1.0), p(0.8, -0.5), p(-0.8, 0.5)];
+    ui.painter().add(egui::Shape::Path(egui::epaint::PathShape::line(pts, egui::epaint::PathStroke::new(1.3, ink))));
+}
+
+/// A screen: for HDMI, DisplayPort and TV outputs.
+fn display_mark(ui: &Ui, c: egui::Pos2, ink: Color32) {
+    let screen = Rect::from_center_size(c + vec2(0.0, -1.0), vec2(14.0, 9.5));
+    ui.painter().rect_stroke(screen, 2.0, egui::Stroke::new(1.4, ink), egui::StrokeKind::Inside);
+    ui.painter().line_segment([pos2(c.x - 3.5, c.y + 6.0), pos2(c.x + 3.5, c.y + 6.0)], egui::Stroke::new(1.4, ink));
+}
+
+/// The audio output button: the same Output device as Settings, here beside the player.
+/// It shows only what the device is (Speaker, Headset, Display) and opens the same list
+/// with the full names; picking changes the device right there. When the choice changes
+/// the mark and word rise in, and a toast names the full device.
+fn output_pill(app: &mut App, ui: &mut Ui, center: egui::Pos2) -> Rect {
+    let ctx = ui.ctx().clone();
+    let now = ui.input(|i| i.time);
+    let full = super::pages::output_device_label(app);
+    let (kind, bluetooth) = device_kind(&full);
+    let word = if app.output_device.is_none() {
+        "Default"
+    } else {
+        match kind {
+            DeviceKind::Speaker => "Speaker",
+            DeviceKind::Headset => "Headset",
+            DeviceKind::Display => "Display",
+        }
+    };
+    // A change of device, seen while the button was on screen: start the entrance.
+    let key = egui::Id::new("np-output-seen");
+    let seen: Option<(String, f64, f64)> = ctx.data(|d| d.get_temp(key));
+    let changed_at = match seen {
+        Some((last, at, last_seen)) if now - last_seen < 1.0 => {
+            if last != full {
+                app.toast(format!("Output: {full}"));
+                now
+            } else {
+                at
+            }
+        }
+        Some((_, at, _)) => at,
+        None => f64::NEG_INFINITY,
+    };
+    ctx.data_mut(|d| d.insert_temp(key, (full.clone(), changed_at, now)));
+    let k = theme::ease_out(((now - changed_at) / 0.45).clamp(0.0, 1.0) as f32);
+    if k < 1.0 {
+        ctx.request_repaint();
+    }
+    let rise = (1.0 - k) * 5.0;
+    let g = widgets::galley(ui, word, badge_font(false), Color32::WHITE, 210.0);
+    let icon_w = 16.0 + if bluetooth { 10.0 } else { 0.0 };
+    let w = icon_w + 6.0 + g.size().x;
+    let rect = Rect::from_center_size(center, vec2(w + 22.0, 26.0));
+    let resp = ui.interact(rect, ui.scope_id().with("np-output"), Sense::click());
+    let resp = named(resp, "Output device").on_hover_text(full.as_str()).on_hover_cursor(egui::CursorIcon::PointingHand);
+    let open = egui::Popup::is_id_open(&ctx, egui::Popup::default_response_id(&resp));
+    let hover = theme::anim_bool(&ctx, resp.id.with("h"), resp.hovered() || open, 0.12);
+    ui.painter().rect_filled(rect, 7.0, Color32::from_white_alpha(13 + (10.0 * hover) as u8));
+    let ink = theme::with_alpha(theme::lerp_color(Color32::from_white_alpha(185), Color32::WHITE, hover), k);
+    let mid = rect.center().y + rise;
+    let x0 = rect.left() + 11.0;
+    let main = pos2(x0 + 8.0, mid);
+    match kind {
+        DeviceKind::Headset => widgets::icon_at(ui, main, theme::icon::HEADPHONES, 15.0, ink),
+        DeviceKind::Speaker => widgets::icon_at(ui, main, theme::icon::VOLUME_2, 15.0, ink),
+        DeviceKind::Display => display_mark(ui, main, ink),
+    }
+    if bluetooth {
+        bluetooth_mark(ui, pos2(x0 + 21.0, mid), 12.0, ink);
+    }
+    ui.painter().galley_with_override_text_color(pos2(x0 + icon_w + 6.0, mid - g.size().y / 2.0), g, ink);
+    super::pages::output_device_popup(app, &resp);
+    rect
+}
