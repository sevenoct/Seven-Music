+/// Settings › Listening: the artists heard most on this computer.
+fn settings_listening(app: &mut App, ui: &mut Ui) {
+    section_label(ui, "Listening", None);
+    let top = app.stats.top_artists(5);
+    let max = top.first().map_or(1, |a| a.1).max(1);
+    settings_card(ui, |ui| {
+        if top.is_empty() {
+            ui.add_space(14.0);
+            ui.label(RichText::new("Play a few songs and the artists you hear most will show up here.").font(theme::regular(13.5)).color(theme::text_dim()));
+            ui.add_space(14.0);
+            return;
+        }
+        for (i, (name, n)) in top.iter().enumerate() {
+            let (r, _) = ui.allocate_exact_size(vec2(ui.available_width(), 46.0), Sense::hover());
+            ui.painter().text(pos2(r.left() + 4.0, r.center().y), Align2::LEFT_CENTER, format!("{}", i + 1), theme::bold(15.0), theme::text_faint());
+            widgets::text_at(ui, pos2(r.left() + 34.0, r.center().y - 9.0), name, theme::semibold(14.5), theme::text(), r.width() * 0.4);
+            // The bar: this artist's plays against the most-played one's.
+            let track = Rect::from_min_max(pos2(r.left() + r.width() * 0.5, r.center().y - 3.0), pos2(r.right() - 64.0, r.center().y + 3.0));
+            ui.painter().rect_filled(track, 3.0, theme::glass(0.08));
+            let fill = Rect::from_min_size(track.min, vec2(track.width() * (*n as f32 / max as f32), track.height()));
+            ui.painter().rect_filled(fill, 3.0, theme::text());
+            ui.painter().text(pos2(r.right() - 4.0, r.center().y), Align2::RIGHT_CENTER, format!("{n} plays"), theme::semibold(12.5), theme::text_dim());
+        }
+    });
+}
