+/// Settings › Storage: what the app saved on disk to go faster, and the way to clear it.
+/// Settings › Updates: the version running, a check on demand, and where the one in
+/// flight has got to. The app also looks by itself shortly after it opens and every six
+/// hours; a version it finds is offered in a dialog with its notes, and downloaded
+/// right away only if Auto updates is on.
+fn settings_updates(app: &mut App, ui: &mut Ui) {
+    use crate::update::State;
+    section_label(ui, "Updates", None);
+    let state = app.updater.as_ref().map_or(State::Idle, |u| u.state());
+    let running = crate::update::current_version();
+    let desc = match &state {
+        State::Idle => format!("Seven {running}. It looks for a newer version by itself after it opens, then every six hours."),
+        State::Checking => "Looking for a newer version…".to_owned(),
+        State::UpToDate => format!("You're on the latest version, Seven {running}."),
+        State::Available { version } => format!("Seven {version} is available. Download it when you're ready."),
+        State::Downloading { version, percent, .. } => format!("Downloading Seven {version}… {percent}%"),
+        State::Ready { version, .. } => format!("Seven {version} is downloaded. Restart the app to finish installing it."),
+        State::Failed(why) => format!("Couldn't check for updates: {why}"),
+    };
+    let (mut check, mut restart, mut notes, mut download, mut history) = (false, false, false, false, false);
+    settings_card(ui, |ui| {
+        setting_row(ui, "Check for updates", Some(desc.as_str()), |ui| match &state {
+            State::Ready { .. } => restart = pill(ui, "Restart to update", None, true).clicked(),
+            State::Available { .. } => download = pill(ui, "Download", None, true).clicked(),
+            State::Checking | State::Downloading { .. } => {
+                ui.label(egui::RichText::new("Working…").font(theme::semibold(14.0)).color(theme::text_dim()));
+            }
+            _ => check = pill(ui, "Check now", None, false).clicked(),
+        });
+        divider(ui);
+        setting_row(ui, "Auto updates", Some("Download a new version as soon as it's found. Turn it off and Seven only tells you about it, and waits for you to download it. Either way it only installs when you restart."), |ui| {
+            toggle(ui, &mut app.auto_updates, "Auto updates");
+        });
+        divider(ui);
+        setting_row(ui, "What's new", Some("The release notes of the version you're running."), |ui| {
+            notes = pill(ui, "Read", None, false).clicked();
+        });
+        divider(ui);
+        setting_row(ui, "Version history", Some("The notes of the last few releases together, handy if you skipped some versions."), |ui| {
+            history = pill(ui, "Show", None, false).clicked();
+        });
+    });
+    if check && let Some(u) = &app.updater {
+        u.check();
+        // The note under the logo follows this check too, and shows what's new on "Up to date".
+        super::tabbar::check_pressed(ui.ctx());
+    }
+    if download && let Some(u) = &app.updater {
+        u.download();
+    }
+    if restart {
+        app.restart_to_update(ui.ctx());
+    }
+    if notes {
+        app.notes_dialog = Some(super::notes::NotesDialog { version: running, ready: false });
+    }
+    if history {
+        app.history_open = true;
+    }
+}
