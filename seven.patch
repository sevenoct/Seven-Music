+fn settings_storage(app: &mut App, ui: &mut Ui) {
+    let ctx = ui.ctx().clone();
+    let storage = app.storage.clone();
+    storage.ensure(&ctx);
+    let (sizes, busy) = (storage.sizes(), storage.busy());
+    let used = |bytes: Option<u64>| match (busy, bytes) {
+        (true, _) => "Working…".to_owned(),
+        (false, Some(b)) => format!("{} used.", crate::cache::fmt(b)),
+        (false, None) => "Checking…".to_owned(),
+    };
+    let cache_desc = format!("Music videos, animated artwork and thumbnails saved so they load faster. They download again when needed. {}", used(sizes.map(|s| s.cache)));
+    let junk_desc = format!("Half-finished downloads and the log of the previous run. Nothing here is used by the app. {}", used(sizes.map(|s| s.junk)));
+    let total_desc = match (busy, sizes) {
+        (false, Some(s)) => format!(
+            "Cache {} · Downloaded songs {} · Settings and other data {} · Junk {}.",
+            crate::cache::fmt(s.cache),
+            crate::cache::fmt(s.downloads),
+            crate::cache::fmt(s.other),
+            crate::cache::fmt(s.junk)
+        ),
+        (true, _) => "Working…".to_owned(),
+        (false, None) => "Checking…".to_owned(),
+    };
+    let total_text = sizes.filter(|_| !busy).map_or("…".to_owned(), |s| crate::cache::fmt(s.total()));
+    section_label(ui, "Storage", None);
+    settings_card(ui, |ui| {
+        setting_row(ui, "Used by Seven", Some(total_desc.as_str()), |ui| {
+            ui.label(egui::RichText::new(total_text).font(theme::semibold(15.0)).color(theme::text()));
+        });
+        divider(ui);
+        setting_row(ui, "Clear cache", Some(cache_desc.as_str()), |ui| {
+            if ui.add_enabled_ui(!busy, |ui| pill(ui, "Clear cache", Some(icon::TRASH_2), false)).inner.clicked() {
+                storage.clear(&ctx, crate::cache::Pile::Cache);
+            }
+        });
+        divider(ui);
+        setting_row(ui, "Clear junk", Some(junk_desc.as_str()), |ui| {
+            if ui.add_enabled_ui(!busy, |ui| pill(ui, "Clear junk", Some(icon::TRASH_2), false)).inner.clicked() {
+                storage.clear(&ctx, crate::cache::Pile::Junk);
+            }
+        });
+    });
 }
 
