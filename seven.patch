+        format!("{}k", n / 1000)
+    } else if n >= 1000 {
+        format!("{:.1}k", n as f64 / 1000.0)
+    } else {
+        n.to_string()
+    }
+}
+
+/// The card that opens Settings: the mark, the name Home greets, and what has been heard
+/// on this computer. Hidden while the page is being searched.
+fn settings_profile(app: &mut App, ui: &mut Ui) {
+    if !search_of(ui).words.is_empty() {
+        return;
+    }
+    let shown_name = {
+        let n = app.display_name.trim();
+        if n.is_empty() { app.account_name.clone().unwrap_or_else(|| "Seven".to_owned()) } else { n.to_owned() }
+    };
+    let plays = app.stats.plays as u64;
+    let minutes = app.stats.minutes();
+    let liked = app.liked.len() as u64;
+    let top = app.stats.top_artists(1).into_iter().next().map(|a| a.0).unwrap_or_else(|| "—".to_owned());
+    ui.add_space(6.0);
+    egui::Frame::new()
+        .fill(egui::Color32::from_rgba_unmultiplied(0, 0, 0, 226))
+        .stroke(egui::Stroke::new(1.0, egui::Color32::from_white_alpha(28)))
+        .corner_radius(theme::panel_radius())
+        .inner_margin(egui::Margin::symmetric(22, 20))
+        .show(ui, |ui| {
+            ui.set_width(ui.available_width());
+            let w = ui.available_width();
+            // The mark and the name.
+            let (head, _) = ui.allocate_exact_size(vec2(w, 64.0), Sense::hover());
+            let disc = Rect::from_min_size(head.min, vec2(64.0, 64.0));
+            super::fx::avatar(app, ui, disc);
+            ui.painter().text(pos2(disc.right() + 16.0, head.center().y - 11.0), Align2::LEFT_CENTER, &shown_name, theme::bold(26.0), theme::text());
+            let sub = match &app.account_name {
+                Some(n) if app.logged_in => format!("Signed in as {n}"),
+                _ => "Not signed in".to_owned(),
+            };
+            ui.painter().text(pos2(disc.right() + 17.0, head.center().y + 16.0), Align2::LEFT_CENTER, sub, theme::regular(13.5), theme::text_dim());
+            ui.add_space(14.0);
+            // The few numbers.
+            let gap = 10.0;
+            let tw = (w - gap * 3.0) / 4.0;
+            let (row, _) = ui.allocate_exact_size(vec2(w, 74.0), Sense::hover());
+            let tiles = [("Songs played", compact(plays)), ("Minutes", compact(minutes)), ("Liked songs", compact(liked)), ("Top artist", top)];
+            for (i, (label, value)) in tiles.iter().enumerate() {
+                let r = Rect::from_min_size(row.min + vec2(i as f32 * (tw + gap), 0.0), vec2(tw, 74.0));
+                ui.painter().rect_filled(r, 14.0, theme::glass(0.07));
+                let font = if i < 3 { theme::bold(24.0) } else { theme::bold(16.0) };
+                widgets::text_at(ui, pos2(r.left() + 14.0, r.top() + if i < 3 { 12.0 } else { 17.0 }), value, font, theme::text(), tw - 28.0);
+                ui.painter().text(pos2(r.left() + 14.0, r.bottom() - 13.0), Align2::LEFT_CENTER, label, theme::semibold(12.0), theme::text_dim());
+            }
+            ui.add_space(16.0);
+            // The name Home greets.
+            ui.horizontal(|ui| {
+                ui.label(RichText::new("Name on Home").font(theme::semibold(13.5)).color(theme::text_dim()));
+                ui.add_space(6.0);
+                settings_field(ui, &mut app.display_name, "Your name", 24);
+            });
+            ui.add_space(10.0);
+            // The portrait: the account's own picture unless one is chosen here.
+            ui.horizontal(|ui| {
+                ui.label(RichText::new("Profile photo").font(theme::semibold(13.5)).color(theme::text_dim()));
+                ui.add_space(6.0);
+                if widgets::pill(ui, "Choose photo", Some(icon::UPLOAD), false).clicked() {
+                    super::fx::pick_photo(app.backend.data_dir());
+                }
+                if super::fx::has_photo(app.backend.data_dir()) && widgets::pill(ui, "Use account photo", None, false).clicked() {
+                    super::fx::clear_photo(app.backend.data_dir());
+                }
+            });
+        });
+}
