+/// A link pill's width, as `widgets::pill` lays it out, so a row of them can be centred.
+fn pill_width(ui: &Ui, label: &str) -> f32 {
+    ui.painter().layout_no_wrap(label.to_owned(), theme::semibold(14.0), egui::Color32::PLACEHOLDER).size().x + 36.0
+}
