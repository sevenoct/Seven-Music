+/// Nine colours for the gradient: the cover's own blurred field sampled on a 3x3 grid
+/// (corners, edges, centre), pushed a little in saturation and kept dark enough for
+/// the white marks. Without a cover the accent stands in, shaded toward the bottom.
+fn gradient_grid(art: Option<&crate::art::Art>, accent: Color32) -> [Color32; 9] {
+    let n = crate::art::SIZE as usize;
+    let mut out = [Color32::BLACK; 9];
+    for (i, o) in out.iter_mut().enumerate() {
+        let (gx, gy) = (i % 3, i / 3);
+        let base = match art.filter(|a| a.rgba.len() >= n * n * 4) {
+            Some(a) => {
+                // A 12x12 box around the grid point (edges pulled in so it stays inside).
+                let cx = [8usize, n / 2, n - 9][gx];
+                let cy = [8usize, n / 2, n - 9][gy];
+                let (mut r, mut g, mut bl, mut cnt) = (0u32, 0u32, 0u32, 0u32);
+                for y in cy - 6..cy + 6 {
+                    for x in cx - 6..cx + 6 {
+                        let p = (y * n + x) * 4;
+                        r += a.rgba[p] as u32;
+                        g += a.rgba[p + 1] as u32;
+                        bl += a.rgba[p + 2] as u32;
+                        cnt += 1;
+                    }
+                }
+                Color32::from_rgb((r / cnt) as u8, (g / cnt) as u8, (bl / cnt) as u8)
+            }
+            None => theme::lerp_color(accent, Color32::BLACK, 0.25 * gy as f32 + 0.1 * gx as f32),
+        };
+        let luma = 0.299 * base.r() as f32 + 0.587 * base.g() as f32 + 0.114 * base.b() as f32;
+        let sat = |c: u8| (luma + (c as f32 - luma) * 1.3).clamp(0.0, 255.0) * 0.82;
+        *o = Color32::from_rgb(sat(base.r()) as u8, sat(base.g()) as u8, sat(base.b()) as u8);
+    }
+    out
+}
