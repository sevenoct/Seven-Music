+//! Small effects borrowed from Mochy Music: the wavy seek line, the like burst, the press
+//! bounce, the visualizer beside the player, the staggered entrance of cards and the
+//! greeting on Home. Everything is drawn with the painter calls the rest of the app
+//! already uses; nothing here owns state beyond a few values kept in egui's own memory.
+
+use egui::{Color32, Context, Id, Pos2, Rect, Response, Ui, pos2, vec2};
+
+use crate::theme;
+
+// ------------------------------------------------------------------ wavy seek line
+
+/// Mochy's wavy slider: the played part of the line is a sine that travels while the song
+/// plays and lies flat when it is paused (`amp` 0..1 eases between the two). The rest of
+/// the line stays straight. The wave starts and ends flat so it meets the knob cleanly.
+/// The caller draws the knob; `gap` is the room to leave for it on either side.
+#[allow(clippy::too_many_arguments)]
+#[allow(dead_code)]
+pub fn wave(ui: &Ui, x0: f32, x1: f32, cy: f32, thick: f32, frac: f32, active: Color32, rest: Color32, gap: f32, amp: f32, time: f64) {
+    let p = ui.painter();
+    let frac = frac.clamp(0.0, 1.0);
+    let xe = x0 + (x1 - x0) * frac;
+    // What is still to play: a straight rounded bar after the knob.
+    let rest_l = xe + gap;
+    if rest_l < x1 {
+        p.rect_filled(Rect::from_min_max(pos2(rest_l, cy - thick / 2.0), pos2(x1, cy + thick / 2.0)), thick / 2.0, rest);
+    }
+    // What was played: the wave, up to the knob's near side.
+    let end = (xe - gap).max(x0);
+    let len = end - x0;
+    if len < 0.5 {
+        return;
+    }
+    let a = amp.clamp(0.0, 1.0) * (1.4 + thick * 0.55);
+    let wl = 24.0 + thick * 2.0;
+    let phase = (time * 5.2) as f32;
+    let step = 2.0;
+    let n = (len / step).ceil() as usize + 1;
+    let mut pts: Vec<Pos2> = Vec::with_capacity(n + 1);
+    for i in 0..=n {
+        let x = (x0 + i as f32 * step).min(end);
+        // Flat at both ends so the line starts and meets the knob on its centre line.
+        let edge = ((x - x0) / 14.0).min((end - x) / 10.0).clamp(0.0, 1.0);
+        let env = edge * edge * (3.0 - 2.0 * edge);
+        let y = cy + a * env * ((x - x0) / wl * std::f32::consts::TAU - phase).sin();
+        pts.push(pos2(x, y));
+    }
+    p.add(egui::Shape::Path(egui::epaint::PathShape::line(pts, egui::epaint::PathStroke::new(thick, active))));
+    // Round caps: the path's own ends are square.
+    p.circle_filled(pos2(x0, cy), thick / 2.0, active);
+    p.circle_filled(pos2(end, cy), thick / 2.0, active);
+    if amp > 0.01 {
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(16));
+    }
+}
+
+// ------------------------------------------------------------------ press bounce
+
+/// How much a pressed control shrinks: 1 at rest, 0.85 while the pointer is down on it,
+/// eased both ways (Mochy's `pressBounce`).
+pub fn press(ctx: &Context, r: &Response) -> f32 {
+    1.0 - 0.15 * theme::anim_bool(ctx, r.id.with("fx-press"), r.is_pointer_button_down_on(), 0.09)
+}
+
+// ------------------------------------------------------------------ like burst
+
+const BURST_SECS: f64 = 0.8;
+
+fn burst_id() -> Id {
+    Id::new("fx-like-bursts")
+}
+
+/// A like landed at `at`: a ring and a spray of small hearts leave from there.
+pub fn burst(ctx: &Context, at: Pos2) {
+    let now = ctx.input(|i| i.time);
+    ctx.data_mut(|d| {
+        let v = d.get_temp_mut_or_default::<Vec<(Pos2, f64)>>(burst_id());
+        if v.len() >= 6 {
+            v.remove(0);
+        }
+        v.push((at, now));
+    });
+    ctx.request_repaint();
+}
+
+fn heart_fill(p: &egui::Painter, center: Pos2, size: f32, color: Color32) {
+    use std::f32::consts::TAU;
+    let s = size / 34.0;
+    let mut mesh = egui::Mesh::default();
+    mesh.colored_vertex(center + vec2(0.0, 1.0 * s), color);
+    const N: u32 = 28;
+    for i in 0..N {
+        let t = i as f32 / N as f32 * TAU;
+        let x = 16.0 * t.sin().powi(3);
+        let y = 13.0 * t.cos() - 5.0 * (2.0 * t).cos() - 2.0 * (3.0 * t).cos() - (4.0 * t).cos();
+        mesh.colored_vertex(center + vec2(x, -y - 2.5) * s, color);
+    }
+    for i in 0..N {
+        mesh.add_triangle(0, 1 + i, 1 + (i + 1) % N);
+    }
+    p.add(egui::Shape::mesh(mesh));
+}
+
+/// Draws the bursts in flight, above everything. Call once a frame.
+pub fn paint_bursts(ctx: &Context) {
+    let now = ctx.input(|i| i.time);
+    let list: Vec<(Pos2, f64)> = ctx.data(|d| d.get_temp::<Vec<(Pos2, f64)>>(burst_id())).unwrap_or_default();
+    if list.is_empty() {
+        return;
+    }
+    let live: Vec<(Pos2, f64)> = list.into_iter().filter(|(_, t0)| now - *t0 < BURST_SECS).collect();
+    ctx.data_mut(|d| d.insert_temp(burst_id(), live.clone()));
+    if live.is_empty() {
+        return;
+    }
+    let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, Id::new("fx-burst-layer")));
+    let red = Color32::from_rgb(0xFF, 0x2D, 0x55);
+    let pink = Color32::from_rgb(0xFF, 0x8F, 0xAB);
+    for (at, t0) in live {
+        let t = ((now - t0) / BURST_SECS) as f32;
+        let out = 1.0 - (1.0 - t).powi(3);
+        let fade = 1.0 - t;
+        // The ring.
+        painter.circle_stroke(at, 8.0 + 30.0 * out, egui::Stroke::new((4.0 * fade).max(0.4), theme::lerp_color(red, Color32::WHITE, t * 0.6).gamma_multiply(0.75 * fade)));
+        // The little hearts, thrown in a circle.
+        let palette = [red, pink, Color32::WHITE];
+        for i in 0..8 {
+            let ang = i as f32 / 8.0 * std::f32::consts::TAU + 0.35 * ((i * 7 % 5) as f32 - 2.0) * 0.2;
+            let reach = 26.0 + 16.0 * ((i * 3 % 4) as f32) / 3.0;
+            let d = 6.0 + reach * out;
+            let c = at + vec2(ang.cos(), ang.sin()) * d;
+            let size = (11.0 + 3.0 * ((i % 3) as f32)) * (1.0 - 0.45 * t);
+            heart_fill(&painter, c, size, palette[i % 3].gamma_multiply(fade));
+        }
+    }
+    ctx.request_repaint();
+}
+
+// ------------------------------------------------------------------ visualizer
+
+/// The audio level, smoothed: quick to rise, slow to fall, so bars lift on a beat and
+/// settle after it. `raw` is the player's own level meter.
+pub fn level(ctx: &Context, raw: f32, playing: bool) -> f32 {
+    let id = Id::new("fx-level");
+    let prev = ctx.data(|d| d.get_temp::<f32>(id)).unwrap_or(0.0);
+    let target = if playing { (raw * 3.0).clamp(0.0, 1.0) } else { 0.0 };
+    let k = if target > prev { 0.45 } else { 0.08 };
+    let now = prev + (target - prev) * k;
+    ctx.data_mut(|d| d.insert_temp(id, now));
+    now
+}
+
+/// Thin bars flanking the player: tallest beside it, shorter outward, moving with the
+/// level. `inner_left` and `inner_right` are where the groups start; each runs out to
+/// its limit, and a side with less than a few bars of room draws nothing.
+pub fn visualizer(ui: &Ui, cy: f32, inner_left: f32, left_limit: f32, inner_right: f32, right_limit: f32, level: f32, time: f64) {
+    const PITCH: f32 = 7.0;
+    const W: f32 = 3.0;
+    const MAX_BARS: usize = 14;
+    let p = ui.painter();
+    let draw = |from: f32, dir: f32, room: f32| {
+        let n = ((room / PITCH) as usize).min(MAX_BARS);
+        if n < 3 {
+            return;
+        }
+        for i in 0..n {
+            let x = from + dir * (i as f32 * PITCH + W / 2.0);
+            // Taller near the player, with each bar following its own rhythm.
+            let env = 1.0 - i as f32 / n as f32 * 0.8;
+            let wob = 0.55 + 0.45 * ((time as f32 * 6.5 + i as f32 * 1.9).sin() * (time as f32 * 3.1 + i as f32 * 0.7).cos()).abs();
+            let h = 3.0 + 26.0 * level * env * wob;
+            let a = (60.0 + 110.0 * level) * env;
+            let r = Rect::from_center_size(pos2(x, cy), vec2(W, h));
+            p.rect_filled(r, W / 2.0, Color32::from_white_alpha(a as u8));
+        }
+    };
+    draw(inner_left, -1.0, inner_left - left_limit);
+    draw(inner_right, 1.0, right_limit - inner_right);
+    if level > 0.01 {
+        ui.ctx().request_repaint_after(std::time::Duration::from_millis(33));
+    }
+}
+
+// ------------------------------------------------------------------ entrance of cards
+
+fn page_t_id() -> Id {
+    Id::new("fx-page-t")
+}
+
+/// Called by the page each frame: how long ago it opened, and the card count starts over.
+pub fn begin_page(ctx: &Context, age: f64) {
+    ctx.data_mut(|d| {
+        d.insert_temp(page_t_id(), age as f32);
+        d.insert_temp(Id::new("fx-slot"), 0u32);
+    });
+}
+
+/// The next card's entrance on the page that just opened: opacity 0..1, each card a beat
+/// after the one before it. `None` once the entrance is over, so nothing is wrapped then.
+pub fn enter(ctx: &Context) -> Option<f32> {
+    let age = ctx.data(|d| d.get_temp::<f32>(page_t_id()))?;
+    let slot = ctx.data_mut(|d| {
+        let s = d.get_temp_mut_or_default::<u32>(Id::new("fx-slot"));
+        let v = *s;
+        *s += 1;
+        v
+    });
+    let delay = (slot as f32 * 0.045).min(0.45);
+    let t = ((age - 0.05 - delay) / 0.32).clamp(0.0, 1.0);
+    if age > 1.2 {
+        return None;
+    }
+    ctx.request_repaint();
+    Some(theme::ease_out(t))
+}
+
+// ------------------------------------------------------------------ greeting
+
+/// The listener's clock now: (hour, minute, weekday 0 = Sunday, day, month 1..12).
+pub fn local_clock() -> (u32, u32, usize, u32, u32) {
+    let secs = crate::ytmapi::local_secs();
+    let days = secs.div_euclid(86_400);
+    let rem = secs.rem_euclid(86_400);
+    let (h, m) = ((rem / 3600) as u32, ((rem % 3600) / 60) as u32);
+    let weekday = (days + 4).rem_euclid(7) as usize;
+    // Civil date from days since 1970-01-01 (Howard Hinnant's algorithm).
+    let z = days + 719_468;
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
+    let mo = (if mp < 10 { mp + 3 } else { mp - 9 }) as u32;
+    (h, m, weekday, d, mo)
+}
+
+/// "Good morning / afternoon / evening / night" for the hour.
+pub fn greeting(hour: u32) -> &'static str {
+    match hour {
+        5..=11 => "Good morning",
+        12..=16 => "Good afternoon",
+        17..=21 => "Good evening",
+        _ => "Good night",
+    }
+}
+
+pub const DAYS: [&str; 7] = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
+pub const MONTHS: [&str; 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+
+/// Used when no account has a name to greet.
+pub const DEFAULT_NAME: &str = "";
+
+// ------------------------------------------------------------------ cover colour
+
+/// The colour a cover leans toward: the vivid average of a small copy of it, found once
+/// per image and kept. `None` while the image has not arrived or cannot be read.
+pub fn cover_tint(ctx: &Context, url: &str) -> Option<Color32> {
+    let id = Id::new(("fx-cover-tint", url));
+    if let Some(c) = ctx.data(|d| d.get_temp::<Option<Color32>>(id)) {
+        return c;
+    }
+    let bytes = match ctx.try_load_bytes(url) {
+        Ok(egui::load::BytesPoll::Ready { bytes, .. }) => bytes,
+        Ok(egui::load::BytesPoll::Pending { .. }) => return None,
+        Err(_) => {
+            ctx.data_mut(|d| d.insert_temp::<Option<Color32>>(id, None));
+            return None;
+        }
+    };
+    let found = image::load_from_memory(bytes.as_ref()).ok().map(|img| {
+        let small = img.to_rgb8();
+        let (mut r, mut g, mut b, mut w) = (0.0f32, 0.0f32, 0.0f32, 0.0f32);
+        for px in small.pixels() {
+            let (pr, pg, pb) = (px[0] as f32, px[1] as f32, px[2] as f32);
+            let (max, min) = (pr.max(pg).max(pb), pr.min(pg).min(pb));
+            let sat = if max > 0.0 { (max - min) / max } else { 0.0 };
+            // Vivid pixels count for more; near-black and grey ones barely at all.
+            let weight = 0.05 + sat * sat * (max / 255.0);
+            r += pr * weight;
+            g += pg * weight;
+            b += pb * weight;
+            w += weight;
+        }
+        if w <= 0.0 {
+            return Color32::from_gray(60);
+        }
+        Color32::from_rgb((r / w) as u8, (g / w) as u8, (b / w) as u8)
+    });
+    ctx.data_mut(|d| d.insert_temp(id, found));
+    found
+}
+
+/// A colour eased toward `target` (r, g, b separately), keyed by `key`.
+pub fn glide(ctx: &Context, key: &str, target: Color32, secs: f32) -> Color32 {
+    let r = theme::anim(ctx, (key, 0u8), target.r() as f32, secs);
+    let g = theme::anim(ctx, (key, 1u8), target.g() as f32, secs);
+    let b = theme::anim(ctx, (key, 2u8), target.b() as f32, secs);
+    Color32::from_rgb(r.clamp(0.0, 255.0) as u8, g.clamp(0.0, 255.0) as u8, b.clamp(0.0, 255.0) as u8)
+}
+
+/// Whether a `Ui` is wide enough to bother with side decorations.
+#[allow(dead_code)]
+pub fn roomy(ui: &Ui) -> bool {
+    ui.available_width() > 600.0
+}
+
+// ------------------------------------------------------------------ flat sliders
+
+/// Mochy's slider: a flat bar, the played part solid from the left, its end cut straight,
+/// and no knob. `track` is the whole line; `frac` how much of it is filled.
+pub fn flat_fill(ui: &Ui, track: Rect, frac: f32, color: Color32) {
+    let w = track.width() * frac.clamp(0.0, 1.0);
+    if w < 0.5 {
+        return;
+    }
+    let r = (track.height() / 2.0).round().clamp(0.0, 255.0) as u8;
+    let cr = egui::CornerRadius { nw: r, sw: r, ne: 0, se: 0 };
+    ui.painter().rect_filled(Rect::from_min_size(track.min, vec2(w, track.height())), cr, color);
+}
+
+// ------------------------------------------------------------------ rest
+
+/// How long the pointer may lie still before the big player's extras fade away.
+const REST_SECS: f64 = 3.0;
+
+/// 1 while the pointer has moved, pressed or scrolled lately (or a key was pressed), and
+/// 0 once it has rested for a few seconds: it falls away slowly and returns almost at
+/// once. The player scales its extra controls by this. Safe to ask more than once a frame.
+pub fn calm(ctx: &Context) -> f32 {
+    let id = Id::new("fx-calm");
+    let (now, dt) = ctx.input(|i| (i.time, i.stable_dt.min(0.1) as f64));
+    let (t_seen, mut k, mut last) = ctx.data(|d| d.get_temp::<(f64, f32, f64)>(id)).unwrap_or((-1.0, 1.0, now));
+    if t_seen == now {
+        return k;
+    }
+    let moved = ctx.input(|i| {
+        i.pointer.delta() != egui::Vec2::ZERO
+            || i.pointer.any_down()
+            || i.smooth_scroll_delta != egui::Vec2::ZERO
+            || i.events.iter().any(|e| matches!(e, egui::Event::Key { .. } | egui::Event::PointerButton { .. }))
+    });
+    if moved {
+        last = now;
+    }
+    if now - last < REST_SECS {
+        k = (k + (dt / 0.12) as f32).min(1.0);
+    } else {
+        k = (k - (dt / 0.8) as f32).max(0.0);
+    }
+    ctx.data_mut(|d| d.insert_temp(id, (now, k, last)));
+    if k > 0.0 && k < 1.0 {
+        ctx.request_repaint();
+    } else if k >= 1.0 {
+        ctx.request_repaint_after(std::time::Duration::from_millis(250));
+    }
+    k
+}
+
+// ------------------------------------------------------------------ profile photo
+
+use super::{App, Page, shell, widgets};
+
+/// The picture the listener chose, a 256 px square kept in the data folder.
+fn photo_path(dir: &std::path::Path) -> std::path::PathBuf {
+    dir.join("profile.png")
+}
+
+/// Asks for a picture (in a thread, so the window keeps going), crops it to a centred
+/// square and keeps it as the profile photo.
+pub fn pick_photo(dir: &std::path::Path) {
+    let dir = dir.to_owned();
+    std::thread::spawn(move || {
+        let Some(file) = rfd::FileDialog::new().set_title("Choose a profile photo").add_filter("Image", &["png", "jpg", "jpeg", "webp", "bmp"]).pick_file() else { return };
+        let Ok(img) = image::open(&file) else { return };
+        let side = img.width().min(img.height());
+        if side == 0 {
+            return;
+        }
+        let square = img.crop_imm((img.width() - side) / 2, (img.height() - side) / 2, side, side);
+        let _ = square.resize_exact(256, 256, image::imageops::FilterType::Lanczos3).save(photo_path(&dir));
+    });
+}
+
+/// Back to the account's own picture.
+pub fn clear_photo(dir: &std::path::Path) {
+    let _ = std::fs::remove_file(photo_path(dir));
+}
+
+/// Whether a photo of the listener's own is set.
+pub fn has_photo(dir: &std::path::Path) -> bool {
+    photo_path(dir).exists()
+}
+
+type PhotoCache = (Option<egui::TextureHandle>, f64, Option<std::time::SystemTime>);
+
+/// The chosen photo as a texture, re-read when the file changes (looked at once a second).
+fn photo_texture(ctx: &Context, dir: &std::path::Path) -> Option<egui::TextureHandle> {
+    let id = Id::new("fx-profile-photo");
+    let now = ctx.input(|i| i.time);
+    let (mut tex, mut checked, mut stamp) = ctx.data(|d| d.get_temp::<PhotoCache>(id)).unwrap_or((None, -10.0, None));
+    if now - checked > 1.0 {
+        checked = now;
+        let path = photo_path(dir);
+        let seen = std::fs::metadata(&path).and_then(|m| m.modified()).ok();
+        if seen != stamp {
+            stamp = seen;
+            tex = seen.and_then(|_| image::open(&path).ok()).map(|img| {
+                let rgba = img.to_rgba8();
+                let size = [rgba.width() as usize, rgba.height() as usize];
+                ctx.load_texture("profile-photo", egui::ColorImage::from_rgba_unmultiplied(size, rgba.as_raw()), egui::TextureOptions::LINEAR)
+            });
+        }
+    }
+    ctx.data_mut(|d| d.insert_temp(id, (tex.clone(), checked, stamp)));
+    tex
+}
+
+/// The listener's round portrait: the photo they chose, else the signed-in account's own
+/// picture, else the mark on a dark disc.
+pub fn avatar(app: &App, ui: &Ui, rect: Rect) {
+    let r = (rect.width() / 2.0).min(127.0);
+    if let Some(tex) = photo_texture(ui.ctx(), app.backend.data_dir()) {
+        egui::Image::from_texture(egui::load::SizedTexture::new(tex.id(), rect.size())).corner_radius(egui::CornerRadius::same(r as u8)).paint_at(ui, rect);
+    } else if let Some(url) = app.account_avatar.as_ref().filter(|a| !a.is_empty()) {
+        widgets::paint_remote(ui, url, rect, r, Rect::from_min_max(pos2(0.0, 0.0), pos2(1.0, 1.0)), Color32::WHITE);
+    } else {
+        ui.painter().circle_filled(rect.center(), r, Color32::from_white_alpha(22));
+        shell::mark(ui, Rect::from_center_size(rect.center(), rect.size() * 0.6), Color32::WHITE);
+    }
+    ui.painter().circle_stroke(rect.center(), r - 0.5, egui::Stroke::new(1.0, Color32::from_white_alpha(34)));
+}
+
+// ------------------------------------------------------------------ pinned heads
+
+fn scrim(ui: &Ui, inner: Rect, ground: Color32, strength: f32) {
+    if strength <= 0.01 {
+        return;
+    }
+    let left = inner.left() - 32.0;
+    let r = Rect::from_min_max(pos2(left, inner.top()), pos2(inner.right() + 24.0, inner.top() + 84.0));
+    shell::vgradient(ui.painter(), r, theme::with_alpha(ground, strength), Color32::TRANSPARENT);
+}
+
+/// Called by a playlist or album with its title, for the pinned head below.
+pub fn note_title(ctx: &Context, title: &str) {
+    ctx.data_mut(|d| d.insert_temp(Id::new("fx-pin-title"), title.to_owned()));
+}
+
+/// What stays at the top of a page once it has scrolled: on Home the mark that opens the
+/// page turns into the word "Home" and keeps its place; a playlist or album keeps its title.
+/// Drawn over the page, with a soft fade under it so the rows slide away beneath.
+pub fn pinned_head(app: &App, ui: &mut Ui, page: &Page, inner: Rect, scroll_y: f32) {
+    let ctx = ui.ctx().clone();
+    let ground = shell::page_ground(app);
+    let left = inner.left() + 2.0;
+    match page {
+        Page::Home => {
+            // The greeting scrolls away; the page's name takes its place at the top.
+            let k = theme::ease_out(((scroll_y - 40.0) / 70.0).clamp(0.0, 1.0));
+            if k <= 0.0 {
+                return;
+            }
+            scrim(ui, inner, ground, k * 0.96);
+            ui.painter().text(pos2(left + 2.0, inner.top() + 30.0 + 6.0 * (1.0 - k)), egui::Align2::LEFT_CENTER, "Home", theme::bold(30.0), theme::with_alpha(theme::text(), k));
+        }
+        Page::Album(_) | Page::Playlist(_) => {
+            let k = ((scroll_y - 210.0) / 60.0).clamp(0.0, 1.0);
+            if k <= 0.0 {
+                return;
+            }
+            let Some(title) = ctx.data(|d| d.get_temp::<String>(Id::new("fx-pin-title"))) else { return };
+            scrim(ui, inner, ground, k * 0.96);
+            let rise = 8.0 * (1.0 - k);
+            ui.painter().text(pos2(left, inner.top() + 28.0 + rise), egui::Align2::LEFT_CENTER, title, theme::bold(24.0), theme::with_alpha(theme::text(), k));
+        }
+        _ => {}
+    }
+}
+
+/// The listener's portrait at the top right of every page; a tap opens Settings, where
+/// the name and photo are changed.
+pub fn profile_button(app: &mut App, ui: &mut Ui, inner: Rect) {
+    let rect = Rect::from_center_size(pos2(inner.right() - 46.0, inner.top() + 30.0), vec2(36.0, 36.0));
+    let resp = ui.interact(rect, Id::new("fx-profile-button"), egui::Sense::click()).on_hover_cursor(egui::CursorIcon::PointingHand);
+    let glow = theme::anim_bool(ui.ctx(), "fx-profile-button-h", resp.hovered(), 0.15);
+    let grown = 36.0 + 3.0 * glow;
+    avatar(app, ui, Rect::from_center_size(rect.center(), vec2(grown, grown)));
+    if resp.clicked() {
+        app.actions.push(super::Action::Go(Page::Settings));
+    }
+}
