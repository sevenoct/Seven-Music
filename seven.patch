+    /// A two-finger swipe across the touchpad: right goes back, left goes forward (the
+    /// setting can turn it round). In the player, or over the player bar, the same swipe
+    /// changes the song instead (right is previous, left is next), with no transition. It reads what is left of the horizontal
+    /// scroll once the page has drawn, so a carousel that scrolls sideways keeps its own
+    /// swipes. The travel needed is long on purpose: a brush of the touchpad does nothing.
+    /// A round glass bead slides in from the edge as the travel builds and the jump follows it.
+    fn swipe_navigation(&mut self, ctx: &egui::Context, now: f64) {
+        use egui::{pos2, vec2};
+        const NEED_NAV: f32 = 520.0;
+        const NEED_SKIP: f32 = 420.0;
+        const QUIET: f64 = 0.8;
+        // "Previous" restarts a song that has been playing for a few seconds instead of leaving it,
+        // so a swipe to the right could land as a restart. Shortly after such a swipe, if it is still
+        // the same song and it is back at its start, go back once more: the swipe means the previous song.
+        let retry_id = egui::Id::new("swipe-prev-retry");
+        if let Some((at, id)) = ctx.data(|d| d.get_temp::<(f64, String)>(retry_id)) {
+            if now - at >= 0.3 {
+                ctx.data_mut(|d| d.remove::<(f64, String)>(retry_id));
+                if self.playing_id() == Some(id.as_str()) && self.audio.status.position_smooth().as_secs_f64() < 1.5 {
+                    self.prev();
+                }
+            } else {
+                ctx.request_repaint_after(std::time::Duration::from_millis(100));
+            }
+        }
+        let (dx, dy) = ctx.input(|i| (i.smooth_scroll_delta.x, i.smooth_scroll_delta.y));
+        // The player bar takes the swipe too, while the pointer is over it.
+        let bar = ctx.data(|d| d.get_temp::<egui::Rect>(egui::Id::new("bar-rect")));
+        let over_bar = bar.is_some_and(|r| ctx.input(|i| i.pointer.hover_pos()).is_some_and(|p| r.expand(4.0).contains(p)));
+        let skip = self.np_open || over_bar;
+        let need = if skip { NEED_SKIP } else { NEED_NAV };
+        if !(if skip { self.swipe_skip } else { self.swipe_nav }) || self.jam_open {
+            self.swipe_acc = 0.0;
+        } else {
+            if now - self.swipe_last > 0.3 {
+                self.swipe_acc = 0.0;
+            }
+            if now - self.swipe_done < QUIET {
+                // Inertia after a jump: it has to go quiet before the next one counts.
+                if dx != 0.0 {
+                    self.swipe_done = now;
+                }
+            } else if dx != 0.0 && dx.abs() > dy.abs() * 2.0 {
+                self.swipe_acc += dx;
+                self.swipe_last = now;
+            }
+            let sign = if self.swipe_invert { -1.0 } else { 1.0 };
+            let back = self.swipe_acc * sign > 0.0;
+            let can = if skip { self.current().is_some() } else if back { !self.back.is_empty() } else { !self.forward.is_empty() };
+            if !can {
+                self.swipe_acc = 0.0;
+            } else if self.swipe_acc.abs() >= need {
+                if skip {
+                    if back {
+                        // Note the song: if this lands as a restart, the retry above goes back once more.
+                        let id = self.playing_id().map(str::to_owned);
+                        self.prev();
+                        if let Some(id) = id {
+                            ctx.data_mut(|d| d.insert_temp(retry_id, (now, id)));
+                        }
+                    } else {
+                        self.next();
+                    }
+                } else if back {
+                    self.nav_back();
+                } else {
+                    self.nav_forward();
+                }
+                self.swipe_fire = Some((now, back));
+                self.swipe_done = now;
+                self.swipe_acc = 0.0;
+            }
+        }
+        // The bead: building while the travel does, then a short fade after the jump.
+        let (p, back, fade) = match self.swipe_fire {
+            Some((t, back)) if now - t < 0.3 => (1.0, back, 1.0 - ((now - t) / 0.3) as f32),
+            _ => {
+                self.swipe_fire = None;
+                let sign = if self.swipe_invert { -1.0 } else { 1.0 };
+                ((self.swipe_acc.abs() / need).clamp(0.0, 1.0), self.swipe_acc * sign > 0.0, 1.0)
+            }
+        };
+        if p <= 0.02 || fade <= 0.0 {
+            return;
+        }
+        ctx.request_repaint();
+        let e = theme::ease_out(p);
+        let screen = ctx.content_rect();
+        let side = if back { 1.0 } else { -1.0 };
+        let x = if back { screen.left() + 8.0 + 52.0 * e - 26.0 } else { screen.right() - 8.0 - 52.0 * e + 26.0 };
+        let c = pos2(x + side * 0.0, screen.center().y);
+        let a = fade * (0.35 + 0.65 * e);
+        let r = 16.0 + 6.0 * e;
+        let painter = ctx.layer_painter(egui::LayerId::new(egui::Order::Tooltip, egui::Id::new("swipe-nav")));
+        painter.circle_filled(c + vec2(0.0, 1.5), r + 1.0, theme::shade(0.25 * a));
+        painter.circle_filled(c, r, Color32::from_black_alpha((215.0 * a) as u8));
+        painter.circle_stroke(c, r - 0.5, egui::Stroke::new(1.0, Color32::from_white_alpha((46.0 * a) as u8)));
+        let dir = if back { -1.0 } else { 1.0 };
+        let ink = Color32::from_white_alpha((235.0 * a) as u8);
+        let s = egui::Stroke::new(2.0, ink);
+        let (hx, hy) = (3.0 * dir, 6.0);
+        painter.line_segment([c + vec2(-hx, -hy), c + vec2(hx, 0.0)], s);
+        painter.line_segment([c + vec2(hx, 0.0), c + vec2(-hx, hy)], s);
+    }
