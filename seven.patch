+/// `text_at`, but a title too long for `width` slides to show its end while `hover` holds
+/// (when the setting is on): a short wait, then back and forth at a walking pace.
+pub fn text_marquee(ui: &Ui, pos: Pos2, text: &str, font: egui::FontId, color: Color32, width: f32, hover: bool) -> Rect {
+    let on = ui.ctx().data(|d| d.get_temp::<bool>(egui::Id::new("marquee-on"))).unwrap_or(false);
+    if !on || crate::bidi::has_rtl(text) {
+        return text_at(ui, pos, text, font, color, width);
+    }
+    let full = galley(ui, text, font.clone(), color, 4000.0);
+    let over = full.size().x - width;
+    let key = egui::Id::new(("marquee-start", text));
+    if over <= 1.0 || !hover {
+        ui.ctx().data_mut(|d| d.remove::<f64>(key));
+        return text_at(ui, pos, text, font, color, width);
+    }
+    let now = ui.input(|i| i.time);
+    let start = ui.ctx().data_mut(|d| *d.get_temp_mut_or_insert_with(key, || now));
+    let t = (now - start - 0.5).max(0.0) as f32;
+    let hold = 50.0;
+    let period = 2.0 * (over + hold);
+    let u = (t * 40.0) % period;
+    let off = if u < over + hold { u.min(over) } else { (period - u).min(over) };
+    let h = full.size().y;
+    let clip = Rect::from_min_size(pos, vec2(width, h)).intersect(ui.clip_rect());
+    ui.painter().with_clip_rect(clip).galley(pos - vec2(off, 0.0), full, color);
+    ui.ctx().request_repaint();
+    Rect::from_min_size(pos, vec2(width, h))
+}
