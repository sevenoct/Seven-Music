diff --git a/src/ui/stats.rs b/src/ui/stats.rs
new file mode 100644
index 0000000..80bdf75
--- /dev/null
+++ b/src/ui/stats.rs
@@ -0,0 +1,84 @@
+//! What Seven has heard, kept on this computer: songs played, time listened, the artists
+//! heard most and the last songs for Home's "Jump back in". A song counts once it has
+//! really played for a while, not when it is merely skipped through.
+
+use std::collections::HashMap;
+
+use serde::{Deserialize, Serialize};
+
+use crate::model::Track;
+
+/// Seconds of one song that make it "played".
+const COUNTS_AFTER: f32 = 20.0;
+/// Songs remembered for "Jump back in".
+const RECENT: usize = 16;
+
+#[derive(Default, Clone, Serialize, Deserialize)]
+pub struct Stats {
+    /// Seconds spent listening, all songs together.
+    pub secs: f64,
+    /// Songs that counted.
+    pub plays: u32,
+    /// Plays per artist name.
+    pub artists: HashMap<String, u32>,
+    /// The latest songs, newest first, each once.
+    pub recent: Vec<Track>,
+    #[serde(skip)]
+    heard_id: String,
+    #[serde(skip)]
+    heard_secs: f32,
+    #[serde(skip)]
+    counted_id: String,
+}
+
+impl Stats {
+    pub fn load(raw: Option<String>) -> Stats {
+        raw.and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default()
+    }
+
+    pub fn save(&self) -> String {
+        serde_json::to_string(self).unwrap_or_default()
+    }
+
+    /// One frame of listening. Returns true when the song just earned its count, and the
+    /// caller then hands it over with [`Stats::count`].
+    pub fn tick(&mut self, id: Option<&str>, playing: bool, dt: f32) -> bool {
+        let Some(id) = id else { return false };
+        if id != self.heard_id {
+            self.heard_id = id.to_owned();
+            self.heard_secs = 0.0;
+        }
+        if !playing {
+            return false;
+        }
+        let dt = dt.clamp(0.0, 0.5);
+        self.secs += dt as f64;
+        self.heard_secs += dt;
+        self.heard_secs >= COUNTS_AFTER && self.counted_id != self.heard_id
+    }
+
+    pub fn count(&mut self, t: &Track) {
+        self.counted_id = t.id.clone();
+        self.plays += 1;
+        for a in &t.artists {
+            if !a.name.trim().is_empty() {
+                *self.artists.entry(a.name.clone()).or_insert(0) += 1;
+            }
+        }
+        self.recent.retain(|r| r.id != t.id);
+        self.recent.insert(0, t.clone());
+        self.recent.truncate(RECENT);
+    }
+
+    pub fn minutes(&self) -> u64 {
+        (self.secs / 60.0) as u64
+    }
+
+    /// The artists heard most, best first.
+    pub fn top_artists(&self, n: usize) -> Vec<(String, u32)> {
+        let mut v: Vec<(String, u32)> = self.artists.iter().map(|(k, v)| (k.clone(), *v)).collect();
+        v.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+        v.truncate(n);
+        v
+    }
+}
