+/// The 3x3 colours laid over `rect` as eight triangles, blending between neighbours.
+fn paint_grid(painter: &egui::Painter, rect: Rect, cols: &[Color32; 9], alpha: f32) {
+    let mut mesh = egui::Mesh::default();
+    for (i, c) in cols.iter().enumerate() {
+        let (gx, gy) = ((i % 3) as f32 / 2.0, (i / 3) as f32 / 2.0);
+        let c = if alpha < 1.0 { theme::with_alpha(*c, alpha) } else { *c };
+        mesh.colored_vertex(pos2(rect.left() + rect.width() * gx, rect.top() + rect.height() * gy), c);
+    }
+    for (x, y) in [(0u32, 0u32), (1, 0), (0, 1), (1, 1)] {
+        let a = y * 3 + x;
+        mesh.add_triangle(a, a + 1, a + 3);
+        mesh.add_triangle(a + 1, a + 4, a + 3);
+    }
+    painter.add(egui::Shape::mesh(mesh));
+}
