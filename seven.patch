+/// The sleep timer's countdown: a thin ring that empties and the time left, in the same
+/// clear box as the output button. A click cancels the timer.
+fn sleep_pill(app: &mut App, ui: &mut Ui, left_mid: egui::Pos2) {
+    let now = ui.input(|i| i.time);
+    let (text, frac) = if let Some(end) = app.sleep_end {
+        let left = (end - now).max(0.0);
+        let total = app.sleep_pick.map_or(0.0, |m| m as f64 * 60.0).max(1.0);
+        let secs = left.ceil() as u32;
+        let text = if secs >= 3600 { format!("{}:{:02}:{:02}", secs / 3600, secs % 3600 / 60, secs % 60) } else { super::fmt_time(secs) };
+        (text, Some((left / total).clamp(0.0, 1.0) as f32))
+    } else if app.sleep_song.is_some() {
+        ("End of song".to_owned(), None)
+    } else {
+        return;
+    };
+    ui.ctx().request_repaint_after(std::time::Duration::from_millis(200));
+    let g = widgets::galley(ui, &text, badge_font(false), Color32::WHITE, 120.0);
+    let w = 14.0 + 6.0 + g.size().x;
+    let rect = Rect::from_min_size(pos2(left_mid.x, left_mid.y - 13.0), vec2(w + 22.0, 26.0));
+    let resp = ui.interact(rect, ui.scope_id().with("np-sleep"), Sense::click());
+    let resp = named(resp, "Sleep timer").on_hover_text("Cancel the sleep timer").on_hover_cursor(egui::CursorIcon::PointingHand);
+    let hover = theme::anim_bool(ui.ctx(), resp.id.with("h"), resp.hovered(), 0.12);
+    ui.painter().rect_filled(rect, 7.0, Color32::from_white_alpha(13 + (10.0 * hover) as u8));
+    let ink = theme::lerp_color(Color32::from_white_alpha(185), Color32::WHITE, hover);
+    let c = pos2(rect.left() + 11.0 + 7.0, rect.center().y);
+    ui.painter().circle_stroke(c, 5.5, egui::Stroke::new(1.4, Color32::from_white_alpha(46)));
+    match frac {
+        Some(f) if f > 0.0 => {
+            // The part still to come, drawn clockwise from the top.
+            let steps = ((f * 48.0).ceil() as usize).max(2);
+            let pts: Vec<egui::Pos2> = (0..=steps)
+                .map(|i| {
+                    let a = -std::f32::consts::FRAC_PI_2 + std::f32::consts::TAU * f * i as f32 / steps as f32;
+                    pos2(c.x + 5.5 * a.cos(), c.y + 5.5 * a.sin())
+                })
+                .collect();
+            ui.painter().add(egui::Shape::Path(egui::epaint::PathShape::line(pts, egui::epaint::PathStroke::new(1.4, ink))));
+        }
+        Some(_) => {}
+        None => {
+            ui.painter().circle_filled(c, 2.2, ink);
+        }
+    }
+    ui.painter().galley_with_override_text_color(pos2(rect.left() + 11.0 + 14.0 + 6.0, rect.center().y - g.size().y / 2.0), g, ink);
+    if resp.clicked() {
+        app.sleep_cancel();
+        app.toast("Sleep timer off");
+    }
 }
 
