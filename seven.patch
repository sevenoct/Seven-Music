+//! The keyboard shortcut help: press `?` and one glass card lists what the keys do. The keys
+//! shown are the ones in use (Settings › Keyboard shortcuts changes them), so it never
+//! disagrees with the app.
+
+use egui::{Align2, Color32, Margin, Stroke, Ui, pos2, vec2};
+
+use super::keys::Cmd;
+use super::{App, pages};
+use crate::theme;
+
+/// What the card lists, in groups. Every command stands in exactly one of them.
+const GROUPS: &[(&str, &[Cmd])] = &[
+    ("Playback", &[Cmd::PlayPause, Cmd::Next, Cmd::Previous, Cmd::VolumeUp, Cmd::VolumeDown, Cmd::Mute]),
+    ("Go to", &[Cmd::Search, Cmd::Back, Cmd::Forward, Cmd::Close]),
+    ("Now playing", &[Cmd::Lyrics, Cmd::Queue, Cmd::Fullscreen, Cmd::Video, Cmd::MiniPlayer, Cmd::ClockMode]),
+];
+
+/// One row: its name on the left, its keycaps on the right.
+fn row(ui: &mut Ui, label: &str, caps: &[String]) {
+    let (rect, _) = ui.allocate_exact_size(vec2(ui.available_width(), 34.0), egui::Sense::hover());
+    ui.painter().text(pos2(rect.left(), rect.center().y), Align2::LEFT_CENTER, label, theme::regular(13.5), theme::text());
+    let mut x = rect.right();
+    for (j, k) in caps.iter().enumerate().rev() {
+        x = pages::keycap(ui, pos2(x, rect.center().y), k) - 6.0;
+        if j > 0 {
+            let plus = ui.painter().text(pos2(x, rect.center().y), Align2::RIGHT_CENTER, "+", theme::regular(13.0), theme::text_dim());
+            x = plus.left() - 6.0;
+        }
+    }
+}
+
+/// A group's small heading, then its rows.
+fn group(ui: &mut Ui, title: &str, rows: &[(String, Vec<String>)]) {
+    ui.add_space(6.0);
+    ui.label(egui::RichText::new(title.to_uppercase()).font(theme::semibold(11.5)).color(theme::text_dim()));
+    ui.add_space(4.0);
+    for (label, caps) in rows {
+        row(ui, label, caps);
+    }
+}
+
+pub fn show(app: &mut App, ctx: &egui::Context) {
+    if !app.help_open {
+        return;
+    }
+    // The groups with the bindings in force now.
+    let mut groups: Vec<(&str, Vec<(String, Vec<String>)>)> = GROUPS
+        .iter()
+        .map(|(title, cmds)| (*title, cmds.iter().map(|c| (c.info().label.to_owned(), app.keys.get(*c).caps())).collect()))
+        .collect();
+    groups.push(("Help", vec![("Show or hide this card".to_owned(), vec!["?".to_owned()])]));
+
+    // OLED glass, like the rail and the player bar.
+    let glass = egui::Frame::new()
+        .fill(Color32::from_rgba_unmultiplied(0x13, 0x13, 0x13, 238))
+        .stroke(Stroke::new(1.5, Color32::from_white_alpha(16)))
+        .corner_radius(24)
+        .shadow(egui::epaint::Shadow { offset: [0, 24], blur: 70, spread: 0, color: theme::shade(0.55) });
+    let screen = ctx.content_rect();
+    let modal = egui::Modal::new(egui::Id::new("shortcut-help")).frame(glass).backdrop_color(theme::shade(0.5)).show(ctx, |ui| {
+        let w = 680.0_f32.min(screen.width() - 48.0);
+        ui.set_width(w);
+        ui.spacing_mut().item_spacing = vec2(0.0, 0.0);
+        egui::Frame::new().inner_margin(Margin { left: 28, right: 28, top: 24, bottom: 22 }).show(ui, |ui| {
+            ui.label(egui::RichText::new("Keyboard shortcuts").font(theme::bold(24.0)).color(theme::text()));
+            ui.add_space(6.0);
+            ui.label(egui::RichText::new("Press ? (or just the / key) any time to open this. Change a key in Settings › Keyboard shortcuts.").font(theme::regular(13.0)).color(theme::text_dim()));
+            ui.add_space(10.0);
+            let max_h = (screen.height() - 220.0).clamp(160.0, 520.0);
+            egui::ScrollArea::vertical().id_salt("shortcut-help-scroll").scroll_bar_visibility(egui::scroll_area::ScrollBarVisibility::AlwaysHidden).max_height(max_h).auto_shrink([false, true]).show(ui, |ui| {
+                if w >= 560.0 {
+                    // Two columns: playback and navigation on the left, the player and help on the right.
+                    let (left, right) = groups.split_at(2);
+                    ui.columns(2, |cols| {
+                        for (title, rows) in left {
+                            group(&mut cols[0], title, rows);
+                        }
+                        for (title, rows) in right {
+                            group(&mut cols[1], title, rows);
+                        }
+                    });
+                } else {
+                    for (title, rows) in &groups {
+                        group(ui, title, rows);
+                    }
+                }
+            });
+        });
+    });
+    if modal.should_close() {
+        app.help_open = false;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_command_is_listed_once() {
+        for cmd in Cmd::ALL {
+            let n = GROUPS.iter().filter(|(_, cmds)| cmds.contains(cmd)).count();
+            assert_eq!(n, 1, "{:?} should be in exactly one group", cmd);
+        }
+    }
+}
