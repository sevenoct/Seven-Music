+//! The floating tab bar, after Mochy Music's Android navigation bar.
+//!
+//! A stadium of dark frosted glass hung above the player. One glyph per tab, outline
+//! when it is off and filled when it is lit, crossfading over 200 ms. One pill sits
+//! behind the lit tab and stretches from tab to tab: its front edge springs ahead of
+//! the back one, so it reaches for the new tab and settles into it instead of sliding
+//! over as a block. A press lifts the pill (it swells a little and brightens) and the
+//! glyph under the pointer squishes to 85%. Pressing and dragging sideways carries the
+//! pill along, and the tab it is let go on opens.
+//!
+//! Measured off Mochy's `AppNavigation.kt` and `NavPill.kt`: a 64 dp bar, the pill
+//! 8 dp in from its top, bottom and ends, 4 dp between neighbouring pills, glyphs at
+//! 22 (Home, Search) and 24 dp, unlit ones at 70%, the lit pill white at 10%, the glass
+//! 78% dark over the blurred cover with a 5% hairline and a faint shadow. The bar stands on the left
+//! edge as a floating rail; below the four tabs it carries the playlists, one cover each,
+//! the way Spotify's library rail does.
+
+use egui::{Rect, Sense, Ui, pos2, vec2};
+
+use super::{Action, App, LibTab, Page, glyphs, shell, widgets};
+use crate::theme;
+
+/// The rail's width.
+pub const W: f32 = 64.0;
+/// How far the rail floats from the window's left edge.
+const EDGE: f32 = 12.0;
+/// Where the rail starts from the top of the window: under the history chevrons.
+const TOP: f32 = 54.0;
+/// One tab's height.
+const SLOT: f32 = 52.0;
+/// How far the pill sits in from the rail's sides.
+const INSET: f32 = 7.0;
+/// Room between a pill and where its neighbour's would be.
+const GAP: f32 = 4.0;
+/// Half the gap is the rail's padding and half is inside each slot.
+const PAD: f32 = INSET - GAP / 2.0;
+/// The tabs' part of the rail.
+const TABS_H: f32 = SLOT * 4.0 + PAD * 2.0;
+/// The rail no longer carries the logo above Home: it stands at the window's bottom left.
+const LOGO_H: f32 = 0.0;
+/// Space between the rail and the player pill under it.
+const ABOVE_PLAYER: f32 = 8.0;
+/// One playlist's row and its cover.
+const ROW: f32 = 46.0;
+const COVER: f32 = 38.0;
+/// How far the page starts from the window's left: the rail, and air beside it.
+pub const PAGE_LEFT: i8 = (EDGE + W + 22.0) as i8;
+
+struct Tab {
+    name: &'static str,
+    off: &'static [u8],
+    on: &'static [u8],
+    size: f32,
+}
+
+const TABS: [Tab; 4] = [
+    Tab { name: "Home", off: glyphs::HOME, on: glyphs::HOME_FILLED, size: 22.0 },
+    Tab { name: "Search", off: glyphs::SEARCH, on: glyphs::SEARCH_FILLED, size: 22.0 },
+    Tab { name: "Library", off: glyphs::LIBRARY, on: glyphs::LIBRARY_FILLED, size: 24.0 },
+    Tab { name: "Settings", off: glyphs::SETTINGS, on: glyphs::SETTINGS_FILLED, size: 24.0 },
+];
+
+/// The tab the page on screen belongs to. A page no tab owns (an album, an artist)
+/// lights none, and the pill fades out where it was.
+pub fn lit_tab(page: &Page) -> Option<usize> {
+    match page {
+        Page::Home => Some(0),
+        Page::Search(_) => Some(1),
+        // New, Downloaded and Transfer were sidebar rows: they live under Library now.
+        Page::Library(_) | Page::Downloads | Page::Local | Page::New | Page::Transfer => Some(2),
+        Page::Settings => Some(3),
+        _ => None,
+    }
+}
+
+/// What a pin is known by: its kind and id. Songs are kept apart (`App::pin_songs`).
+pub fn pin_key(t: &crate::model::Target) -> Option<String> {
+    use crate::model::Target;
+    match t {
+        Target::Album(id) => Some(format!("a:{id}")),
+        Target::Playlist(id) => Some(format!("p:{id}")),
+        Target::Artist(id) => Some(format!("r:{id}")),
+        _ => None,
+    }
+}
+
+/// Opens a tab the way the sidebar's rows do.
+fn open(app: &mut App, i: usize) {
+    let page = match i {
+        0 => Page::Home,
+        1 => {
+            // Search lands with the caret in the box; already there, it brings the box back.
+            app.search_refocus = true;
+            if matches!(app.page, Page::Search(_)) {
+                return;
+            }
+            Page::Search(String::new())
+        }
+        2 => Page::Library(LibTab::Playlists),
+        _ => Page::Settings,
+    };
+    app.actions.push(Action::Go(page));
+}
+
+/// Draws the rail on the window's left edge, from under the chevrons down to the player.
+pub fn show(app: &mut App, ctx: &egui::Context) {
+    let screen = ctx.content_rect();
+    let top = screen.top() + TOP;
+    let bottom = screen.bottom() - app.bar_height() - ABOVE_PLAYER;
+    if bottom - top < TABS_H + LOGO_H {
+        return;
+    }
+    let at = pos2(screen.left() + EDGE, top);
+    let room = bottom - top;
+    egui::Area::new(egui::Id::new("tab-bar"))
+        .fixed_pos(at)
+        .order(egui::Order::Middle)
+        .show(ctx, |ui| bar(app, ui, room));
+    cards(app, ctx, pos2(at.x, bottom));
+    logo(app, ctx, screen);
+    update_note(app, ctx, screen);
+}
+
+/// The mark, flat at the window's bottom left beside the player; a tap opens Settings at its About Seven card.
+fn logo(app: &mut App, ctx: &egui::Context, screen: Rect) {
+    // Raised a little: the update note stands under it.
+    let cell = Rect::from_center_size(pos2(screen.left() + EDGE + W / 2.0, screen.bottom() - 60.0), vec2(W, 40.0));
+    egui::Area::new(egui::Id::new("tab-bar-logo-area")).fixed_pos(cell.min).order(egui::Order::Middle).show(ctx, |ui| {
+        let (rect, resp) = ui.allocate_exact_size(cell.size(), Sense::click());
+        let resp = resp.on_hover_cursor(egui::CursorIcon::PointingHand);
+        let glow = theme::anim_bool(ui.ctx(), "tab-bar-logo-h", resp.hovered(), 0.15);
+        // Black on light pages, white on dark ones.
+        let on_light = ui.ctx().data(|d| d.get_temp::<bool>(egui::Id::new("pages-light"))).unwrap_or(false);
+        let a = (200.0 + 55.0 * glow) as u8;
+        let ink = if on_light { egui::Color32::from_black_alpha(a) } else { egui::Color32::from_white_alpha(a) };
+        shell::mark(ui, Rect::from_center_size(rect.center(), vec2(30.0, 30.0)), ink);
+        if resp.clicked() {
+            app.settings_search.clear();
+            app.jam_open = false;
+            app.about_jump = ui.input(|i| i.time) + 0.8;
+            app.actions.push(Action::Go(Page::Settings));
+        }
+    });
+}
+
+/// A check was asked for by hand (the note under the logo, or Settings' "Check now"): the note
+/// reads "Checking…" and then the result, and "Up to date" brings the what's-new card back.
+/// Settings uses this too, so the two ways of asking behave the same.
+pub fn check_pressed(ctx: &egui::Context) {
+    let now = ctx.input(|i| i.time);
+    ctx.data_mut(|d| {
+        d.insert_temp(egui::Id::new("update-note-tap"), now);
+        d.remove_temp::<f64>(egui::Id::new("update-note-done"));
+    });
+}
+
+/// Small print under the logo: the version number while nothing is going on. A tap checks for
+/// updates: it reads "Checking…", then the result ("Up to date") for a moment, then goes back
+/// to the version. A download in progress, or one ready to install, shows in its place.
+fn update_note(app: &mut App, ctx: &egui::Context, screen: Rect) {
+    use crate::update::State;
+    use std::time::Duration;
+    // The shortest time "Checking…" stays up, and how long the result stays after it.
+    const MIN_CHECK: f64 = 0.8;
+    const SHOW_RESULT: f64 = 2.5;
+    let state = app.updater.as_ref().map_or(State::Idle, |u| u.state());
+    let now = ctx.input(|i| i.time);
+    let (tap_id, done_id) = (egui::Id::new("update-note-tap"), egui::Id::new("update-note-done"));
+    let tap: Option<f64> = ctx.data(|d| d.get_temp(tap_id));
+    let done: Option<f64> = ctx.data(|d| d.get_temp(done_id));
+    let clear = |ctx: &egui::Context| {
+        ctx.data_mut(|d| {
+            d.remove_temp::<f64>(tap_id);
+            d.remove_temp::<f64>(done_id);
+        });
+    };
+    let (text, ready) = match &state {
+        State::Downloading { percent, .. } => {
+            clear(ctx);
+            (format!("Downloading\n{percent}%"), false)
+        }
+        State::Ready { .. } => {
+            clear(ctx);
+            ("Restart to\nupdate".to_owned(), true)
+        }
+        State::Available { .. } => {
+            clear(ctx);
+            ("Update\navailable".to_owned(), true)
+        }
+        _ => {
+            let mut text = format!("v{}", crate::update::current_version());
+            if let Some(t0) = tap {
+                let busy = now - t0 < MIN_CHECK;
+                let result = match &state {
+                    State::UpToDate => Some("Up to date"),
+                    State::Failed(_) => Some("Check failed"),
+                    _ => None,
+                };
+                if matches!(state, State::Checking) || (busy && result.is_some()) {
+                    text = "Checking…".to_owned();
+                    if busy {
+                        ctx.request_repaint_after(Duration::from_secs_f64(MIN_CHECK - (now - t0) + 0.05));
+                    }
+                } else if let Some(r) = result {
+                    let at = done.unwrap_or(now);
+                    if done.is_none() {
+                        ctx.data_mut(|d| d.insert_temp(done_id, now));
+                        // Tapped and already on the latest: the corner card with what's new in
+                        // this version shows again, like after an update.
+                        if matches!(state, State::UpToDate) {
+                            app.whats_new = Some(crate::update::current_version());
+                        }
+                    }
+                    if now - at < SHOW_RESULT {
+                        text = r.to_owned();
+                        ctx.request_repaint_after(Duration::from_secs_f64(SHOW_RESULT - (now - at) + 0.05));
+                    } else {
+                        clear(ctx);
+                    }
+                } else {
+                    clear(ctx);
+                }
+            }
+            (text, false)
+        }
+    };
+    let cell = Rect::from_center_size(pos2(screen.left() + EDGE + W / 2.0, screen.bottom() - 26.0), vec2(W, 26.0));
+    let accent = app.accent_color();
+    let mut tapped = false;
+    egui::Area::new(egui::Id::new("tab-bar-update-area")).fixed_pos(cell.min).order(egui::Order::Middle).show(ctx, |ui| {
+        let (rect, resp) = ui.allocate_exact_size(cell.size(), Sense::click());
+        let resp = resp.on_hover_cursor(egui::CursorIcon::PointingHand).on_hover_text("Check for updates");
+        let glow = theme::anim_bool(ui.ctx(), "tab-bar-update-h", resp.hovered(), 0.15);
+        // Dark on light pages, white on dark ones, like the logo above.
+        let on_light = ui.ctx().data(|d| d.get_temp::<bool>(egui::Id::new("pages-light"))).unwrap_or(false);
+        let a = (140.0 + 90.0 * glow) as u8;
+        // "Update available" breathes slowly, so it reads as waiting for you.
+        let pulse = if matches!(state, State::Available { .. }) {
+            ui.ctx().request_repaint_after(Duration::from_millis(40));
+            0.62 + 0.38 * (0.5 + 0.5 * (ui.input(|i| i.time) * std::f64::consts::TAU / 2.4).sin() as f32)
+        } else {
+            1.0
+        };
+        let ink = if ready {
+            accent.gamma_multiply(pulse)
+        } else if on_light {
+            egui::Color32::from_black_alpha(a)
+        } else {
+            egui::Color32::from_white_alpha(a)
+        };
+        let lines: Vec<&str> = text.split('\n').collect();
+        let size = if lines.len() == 1 { 10.5 } else { 9.5 };
+        let top = rect.center().y - (lines.len() as f32 - 1.0) * 5.5;
+        for (i, line) in lines.iter().enumerate() {
+            ui.painter().text(pos2(rect.center().x, top + 11.0 * i as f32), egui::Align2::CENTER_CENTER, *line, theme::semibold(size), ink);
+        }
+        tapped = resp.clicked();
+    });
+    if !tapped {
+        return;
+    }
+    match state {
+        State::Ready { .. } => app.restart_to_update(ctx),
+        // Automatic updates are off: the tap opens the notice, where Download is.
+        State::Available { version } => app.notes_dialog = Some(super::notes::NotesDialog { version, ready: true }),
+        State::Downloading { .. } => {}
+        State::Checking => check_pressed(ctx),
+        _ => {
+            if let Some(u) = &app.updater {
+                u.check();
+                check_pressed(ctx);
+            }
+        }
+    }
+}
+
+/// What sat at the foot of the sidebar: the update card and the transfer's progress.
+fn cards(app: &mut App, ctx: &egui::Context, bar_at: egui::Pos2) {
+    let ready = app.updater.as_ref().and_then(|u| match u.state() {
+        crate::update::State::Ready { version, .. } => Some(version),
+        _ => None,
+    });
+    let transferring = super::transfer::sidebar_visible(app, ctx.input(|i| i.time));
+    if ready.is_none() && !transferring {
+        return;
+    }
+    let mut restart = false;
+    egui::Area::new(egui::Id::new("tab-bar-cards"))
+        .order(egui::Order::Middle)
+        .pivot(egui::Align2::LEFT_BOTTOM)
+        .fixed_pos(pos2(bar_at.x + W + 12.0, bar_at.y))
+        .show(ctx, |ui| {
+            ui.set_width(230.0);
+            if transferring {
+                super::transfer::sidebar_card(app, ui, false, 1.0, 28.0);
+                ui.add_space(6.0);
+            }
+            if let Some(v) = &ready
+                && widgets::pill(ui, &format!("Restart to update to {v}"), None, true).clicked()
+            {
+                restart = true;
+            }
+        });
+    if restart {
+        app.restart_to_update(ctx);
+    }
+}
+
+/// The sidebar's other entries, as chips along the top of the Library's pages.
+pub fn library_chips(app: &mut App, ui: &mut Ui) {
+    let current = app.page.clone();
+    let items: [(&str, Page); 10] = [
+        ("Playlists", Page::Library(LibTab::Playlists)),
+        ("Favourite Songs", Page::Playlist(super::LIKED_MUSIC.to_owned())),
+        ("Songs", Page::Library(LibTab::History)),
+        ("Albums", Page::Library(LibTab::Albums)),
+        ("Artists", Page::Library(LibTab::Artists)),
+        ("Downloaded", Page::Downloads),
+        ("Local", Page::Local),
+        ("Uploads", Page::Library(LibTab::Uploads)),
+        ("New", Page::New),
+        ("Transfer", Page::Transfer),
+    ];
+    ui.add_space(2.0);
+    ui.horizontal_wrapped(|ui| {
+        for (label, page) in items {
+            let on = current == page;
+            if widgets::pill(ui, label, None, on).clicked() && !on {
+                app.actions.push(Action::Go(page));
+            }
+        }
+    });
+    ui.add_space(4.0);
+}
+
+/// The playlists to show on the rail, in the order the sidebar kept them.
+fn rail_playlists(app: &mut App) -> Vec<(String, String, Vec<crate::model::Thumb>)> {
+    use crate::model::Target;
+    if !app.logged_in {
+        return Vec::new();
+    }
+    // Playlists that appeared since the order was last changed join it at the end.
+    if let Some(l) = &app.library {
+        for c in &l.playlists {
+            if let Target::Playlist(id) = &c.target
+                && !app.playlist_order.contains(id)
+            {
+                app.playlist_order.push(id.clone());
+            }
+        }
+    }
+    let Some(list) = app.library.as_ref().map(|l| &l.playlists).or(app.sidebar_cache.as_ref()) else {
+        return Vec::new();
+    };
+    let mut out: Vec<(usize, String, String, Vec<crate::model::Thumb>)> = list
+        .iter()
+        .filter_map(|c| match &c.target {
+            Target::Playlist(id) if !matches!(id.as_str(), "LM" | "VLLM") && !app.hidden_playlists.contains(id) => {
+                let at = app.playlist_order.iter().position(|x| x == id).unwrap_or(usize::MAX);
+                Some((at, id.clone(), c.title.clone(), c.thumbs.clone()))
+            }
+            _ => None,
+        })
+        .collect();
+    out.sort_by_key(|(at, ..)| *at);
+    out.into_iter().map(|(_, id, t, th)| (id, t, th)).collect()
+}
+
+/// A row of the rail's list being carried to a new place: its group (0 the pins, 1 the
+/// pinned songs, 2 the playlists), the row that was picked up, and the row it would land on.
+#[derive(Clone, Copy)]
+struct Carry {
+    group: u8,
+    from: usize,
+    to: usize,
+}
+
+/// Dragging for row `i` of a group of `len` rows whose first row is at `top`. The row that is
+/// carried follows the pointer; the rows between it and where it would land step aside to
+/// make room. Returns the rect to draw the row in and how lifted it is (0 to 1). Letting go
+/// puts the finished move in `dropped`.
+#[allow(clippy::too_many_arguments)]
+fn carry_row(ctx: &egui::Context, group: u8, key: &str, i: usize, len: usize, top: f32, cell: Rect, resp: &egui::Response, carry: &mut Option<Carry>, dropped: &mut Option<Carry>) -> (Rect, f32) {
+    if resp.drag_started() {
+        *carry = Some(Carry { group, from: i, to: i });
+    }
+    let mine = carry.is_some_and(|c| c.group == group && c.from == i);
+    let id = (group, key.to_owned());
+    let carried = mine && resp.dragged();
+    let rel = if carried {
+        ctx.set_cursor_icon(egui::CursorIcon::Grabbing);
+        let y = ctx.pointer_latest_pos().map_or(cell.center().y, |p| p.y);
+        if let Some(c) = carry.as_mut() {
+            c.to = (((y - top) / ROW).floor().max(0.0) as usize).min(len - 1);
+        }
+        // Straight under the pointer, but never out past the group's first or last row.
+        let rel = (y - top - ROW / 2.0).clamp(0.0, ROW * (len as f32 - 1.0));
+        theme::anim(ctx, &id, rel, 0.02)
+    } else {
+        let shift = match *carry {
+            Some(c) if c.group == group && c.from < c.to && i > c.from && i <= c.to => -ROW,
+            Some(c) if c.group == group && c.from > c.to && i >= c.to && i < c.from => ROW,
+            _ => 0.0,
+        };
+        theme::anim(ctx, &id, i as f32 * ROW + shift, 0.16)
+    };
+    if mine && resp.drag_stopped() {
+        *dropped = carry.take();
+    }
+    let lift = theme::anim_bool(ctx, (group, key.to_owned(), "lift"), carried, 0.12);
+    (Rect::from_min_size(pos2(cell.left(), top + rel), cell.size()), lift)
+}
+
+/// A soft shadow under a row that is picked up.
+fn lift_shadow(ui: &Ui, cover: Rect, radius: f32, lift: f32) {
+    if lift > 0.0 {
+        let under = cover.translate(vec2(0.0, 3.0)).expand(2.0 * lift);
+        ui.painter().rect_filled(under, radius + 2.0, egui::Color32::from_black_alpha((120.0 * lift) as u8));
+    }
+}
+
+/// Moves item `from` to place `to`.
+fn move_item<T>(v: &mut Vec<T>, from: usize, to: usize) {
+    if from < v.len() && to < v.len() && from != to {
+        let item = v.remove(from);
+        v.insert(to, item);
+    }
+}
+
+fn bar(app: &mut App, ui: &mut Ui, room: f32) {
+    let ctx = ui.ctx().clone();
+    let pins: Vec<crate::model::Card> = app.pins.clone();
+    let songs: Vec<crate::model::Track> = app.pin_songs.clone();
+    let pinned_keys: Vec<String> = pins.iter().filter_map(|c| pin_key(&c.target)).collect();
+    // A playlist that is pinned stands once, among the pins.
+    let lists: Vec<_> = rail_playlists(app).into_iter().filter(|(id, ..)| !pinned_keys.contains(&format!("p:{id}"))).collect();
+    // Favourite Songs leads the list, then the pins; the rest follow.
+    let rows = lists.len() + pins.len() + songs.len() + usize::from(app.logged_in);
+    let list_h = rows as f32 * ROW;
+    let want = LOGO_H + if rows > 0 { TABS_H + 12.0 + list_h + PAD } else { TABS_H };
+    let h = want.min(room);
+    let (rect, _) = ui.allocate_exact_size(vec2(W, h), Sense::hover());
+    let oy = rect.top() + LOGO_H;
+    let tabs = Rect::from_min_size(pos2(rect.left(), oy), vec2(W, TABS_H));
+    let resp = ui.interact(tabs, egui::Id::new("tab-bar-tabs"), Sense::click_and_drag()).on_hover_cursor(egui::CursorIcon::PointingHand);
+    let tab_at = |y: f32| ((y - oy - PAD) / SLOT).floor().clamp(0.0, 3.0) as usize;
+    let pointer = ui.input(|i| i.pointer.latest_pos());
+    let pressed = resp.is_pointer_button_down_on();
+    // The tab under a finger that is down on the rail: it is lit and carries the pill
+    // while the finger is down, wherever the page says it is.
+    let held = if pressed { pointer.map(|p| tab_at(p.y)) } else { None };
+    let lit = lit_tab(&app.page);
+
+    // Where the pill is headed. With no lit tab it stays where it was, and fades.
+    let rest_id = egui::Id::new("tab-bar-rest");
+    let rest: f32 = ctx.data(|d| d.get_temp(rest_id)).unwrap_or(0.0);
+    let target = held.or(lit).map_or(rest, |i| i as f32);
+    ctx.data_mut(|d| d.insert_temp(rest_id, target));
+
+    // Its front edge springs to the new tab faster than the back one.
+    let dir_id = egui::Id::new("tab-bar-dir");
+    let (prev, down): (f32, bool) = ctx.data(|d| d.get_temp(dir_id)).unwrap_or((target, true));
+    let down = if (target - prev).abs() > 0.01 { target > prev } else { down };
+    ctx.data_mut(|d| d.insert_temp(dir_id, (target, down)));
+    let (back_secs, front_secs) = (0.30, 0.14);
+    let (start_secs, end_secs) = if down { (back_secs, front_secs) } else { (front_secs, back_secs) };
+    let start = theme::anim(&ctx, "tab-bar-start", target, start_secs);
+    let end = theme::anim(&ctx, "tab-bar-end", target, end_secs);
+    let (start, end) = (start.min(end), start.max(end));
+    // The leading edge goes a little past its tab and settles back as the other catches up
+    // (never more than the rail's own padding allows).
+    let spring = ((end - start) * 0.12).min(0.10);
+    let (start, end) = if down { (start, end + spring) } else { (start - spring, end) };
+    let shown = theme::anim_bool(&ctx, "tab-bar-shown", held.is_some() || lit.is_some(), 0.2);
+    let lift = theme::anim_bool(&ctx, "tab-bar-lift", pressed, 0.14);
+
+    // The glass: OLED black with a bright rim, and nothing behind or over it.
+    let radius = W / 2.0;
+    shell::chrome_glass(app, ui, rect, radius);
+
+    // The pill: it swells past its slot and brightens while a finger is on it.
+    let grow = lift * 3.0;
+    let y0 = oy + PAD + start * SLOT + GAP / 2.0;
+    let y1 = oy + PAD + (end + 1.0) * SLOT - GAP / 2.0;
+    let pill = Rect::from_min_max(
+        pos2(rect.left() + INSET - grow, y0 - grow),
+        pos2(rect.right() - INSET + grow, y1 + grow),
+    );
+    let pill_color = theme::with_alpha(theme::glass(0.12 * (1.0 + 0.7 * lift)), shown);
+    ui.painter().rect_filled(pill, pill.width() / 2.0, pill_color);
+
+    // The glyphs: outline at 70% when off, filled at full when lit, one fading into the other.
+    let ink = theme::text();
+    for (i, tab) in TABS.iter().enumerate() {
+        let on = held.or(lit) == Some(i);
+        let lit_amount = theme::anim_bool(&ctx, ("tab-bar-lit", i), on, 0.2);
+        let squish = theme::anim_bool(&ctx, ("tab-bar-squish", i), held == Some(i), 0.1);
+        let size = tab.size * (1.0 - 0.15 * squish);
+        let centre = pos2(rect.center().x, oy + PAD + (i as f32 + 0.5) * SLOT);
+        glyphs::draw(ui, centre, size, tab.off, theme::with_alpha(ink, 0.7 * (1.0 - lit_amount)));
+        glyphs::draw(ui, centre, size, tab.on, theme::with_alpha(ink, lit_amount));
+    }
+
+    if let Some(p) = resp.hover_pos() {
+        let _ = resp.clone().on_hover_text(TABS[tab_at(p.y)].name);
+    }
+    // A tap opens the tab under it; a drag opens the one it is let go on.
+    if resp.clicked() || resp.drag_stopped() {
+        if let Some(p) = pointer {
+            let tab = tab_at(p.y);
+            if tab == 3 {
+                // Settings always opens at its top, wherever it was left scrolled to.
+                ctx.data_mut(|d| d.insert_temp(egui::Id::new("settings-to-top"), true));
+            }
+            open(app, tab);
+        }
+    }
+
+    // The playlists, under a hairline: Favourite Songs first, then one cover each.
+    if rows == 0 || h < LOGO_H + TABS_H + ROW {
+        return;
+    }
+    let line_y = oy + TABS_H + 2.0;
+    ui.painter().line_segment(
+        [pos2(rect.left() + 16.0, line_y), pos2(rect.right() - 16.0, line_y)],
+        egui::Stroke::new(1.0, theme::glass(0.10)),
+    );
+    let area = Rect::from_min_max(pos2(rect.left(), line_y + 6.0), pos2(rect.right(), rect.bottom() - PAD));
+    let mut hide: Option<String> = None;
+    let mut unpin: Option<crate::model::Card> = None;
+    let mut unpin_song: Option<crate::model::Track> = None;
+    let mut play_song: Option<crate::model::Track> = None;
+    let mut pin_open: Option<crate::model::Target> = None;
+    let mut open_target: Option<Page> = None;
+    // A row picked up to be moved, and a move that was just let go.
+    let carry_id = egui::Id::new("rail-carry");
+    let mut carry: Option<Carry> = ctx.data(|d| d.get_temp::<Option<Carry>>(carry_id)).flatten();
+    let mut dropped: Option<Carry> = None;
+    ui.scope_builder(egui::UiBuilder::new().max_rect(area), |ui| {
+        egui::ScrollArea::vertical().scroll_bar_visibility(egui::scroll_area::ScrollBarVisibility::AlwaysHidden)
+            .id_salt("rail-playlists")
+            .auto_shrink(false)
+            .scroll_bar_visibility(egui::scroll_area::ScrollBarVisibility::AlwaysHidden)
+            .show(ui, |ui| {
+                ui.spacing_mut().item_spacing.y = 0.0;
+                // A drag that ended unseen (its row scrolled away) doesn't stay picked up.
+                if carry.is_some() && !ui.input(|i| i.pointer.any_down() || i.pointer.any_released()) {
+                    carry = None;
+                }
+                // Carrying a row to the rail's edge scrolls it.
+                if carry.is_some()
+                    && let Some(p) = ctx.pointer_latest_pos()
+                {
+                    let edge = 30.0;
+                    if p.y < area.top() + edge {
+                        ui.scroll_with_delta(vec2(0.0, 10.0));
+                    } else if p.y > area.bottom() - edge {
+                        ui.scroll_with_delta(vec2(0.0, -10.0));
+                    }
+                    ctx.request_repaint();
+                }
+                // Favourite Songs.
+                if app.logged_in {
+                let liked = Page::Playlist(super::LIKED_MUSIC.to_owned());
+                let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click());
+                let resp = widgets::named(resp, "Favourite Songs").on_hover_text("Favourite Songs").on_hover_cursor(egui::CursorIcon::PointingHand);
+                let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER));
+                let sel = app.page == liked;
+                let h = theme::anim_bool(&ctx, "rail-liked-h", resp.hovered(), 0.15);
+                ui.painter().rect_filled(c, 11.0, theme::glass(0.16 + 0.10 * h));
+                glyphs::draw(ui, c.center(), 18.0, glyphs::STAR_FILLED, theme::text());
+                if sel {
+                    ui.painter().rect_stroke(c.expand(2.0), 13.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                }
+                if resp.clicked() {
+                    open_target = Some(liked);
+                }
+                }
+                // The pins: playlists, albums and artists the listener chose to keep close.
+                let top = ui.cursor().top();
+                for (i, card) in pins.iter().enumerate() {
+                    let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click_and_drag());
+                    if !ui.is_rect_visible(cell) {
+                        continue;
+                    }
+                    let (cell, lift) = carry_row(&ctx, 0, &pin_key(&card.target).unwrap_or_default(), i, pins.len(), top, cell, &resp, &mut carry, &mut dropped);
+                    let resp = widgets::named(resp, &card.title).on_hover_text(&card.title).on_hover_cursor(egui::CursorIcon::PointingHand);
+                    let h = theme::anim_bool(&ctx, resp.id.with("h"), resp.hovered(), 0.15);
+                    let sel = match &card.target {
+                        crate::model::Target::Playlist(id) => app.page == Page::Playlist(id.clone()),
+                        crate::model::Target::Album(id) => app.page == Page::Album(id.clone()),
+                        crate::model::Target::Artist(id) => app.page == Page::Artist(id.clone()),
+                        _ => false,
+                    };
+                    let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER)).expand(1.5 * h + 2.0 * lift);
+                    let round = matches!(card.target, crate::model::Target::Artist(_));
+                    let radius = if round { c.width() / 2.0 } else { 11.0 };
+                    lift_shadow(ui, c, radius, lift);
+                    widgets::paint_cover(ui, c, &card.thumbs, radius, 1.0);
+                    if sel {
+                        ui.painter().rect_stroke(c.expand(2.0), radius + 2.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                    }
+                    egui::Popup::context_menu(&resp).show(|ui| {
+                        ui.set_min_width(190.0);
+                        if ui.button("Unpin from sidebar").clicked() {
+                            unpin = Some(card.clone());
+                            ui.close();
+                        }
+                    });
+                    if resp.clicked() {
+                        pin_open = Some(card.target.clone());
+                    }
+                }
+                // The songs kept here: a tap plays one.
+                let top = ui.cursor().top();
+                for (i, t) in songs.iter().enumerate() {
+                    let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click_and_drag());
+                    if !ui.is_rect_visible(cell) {
+                        continue;
+                    }
+                    let (cell, lift) = carry_row(&ctx, 1, &t.id, i, songs.len(), top, cell, &resp, &mut carry, &mut dropped);
+                    let resp = widgets::named(resp, &t.title).on_hover_text(&t.title).on_hover_cursor(egui::CursorIcon::PointingHand);
+                    let h = theme::anim_bool(&ctx, resp.id.with("h"), resp.hovered(), 0.15);
+                    let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER)).expand(1.5 * h + 2.0 * lift);
+                    lift_shadow(ui, c, 11.0, lift);
+                    widgets::paint_cover(ui, c, &t.thumbs, 11.0, 1.0);
+                    if app.playing_id() == Some(t.id.as_str()) {
+                        ui.painter().rect_stroke(c.expand(2.0), 13.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                    }
+                    egui::Popup::context_menu(&resp).show(|ui| {
+                        ui.set_min_width(190.0);
+                        if ui.button("Unpin from sidebar").clicked() {
+                            unpin_song = Some(t.clone());
+                            ui.close();
+                        }
+                    });
+                    if resp.clicked() {
+                        play_song = Some(t.clone());
+                    }
+                }
+                let top = ui.cursor().top();
+                for (i, (id, title, thumbs)) in lists.iter().enumerate() {
+                    let (cell, resp) = ui.allocate_exact_size(vec2(W, ROW), Sense::click_and_drag());
+                    if !ui.is_rect_visible(cell) {
+                        continue;
+                    }
+                    let (cell, lift) = carry_row(&ctx, 2, id, i, lists.len(), top, cell, &resp, &mut carry, &mut dropped);
+                    let resp = widgets::named(resp, title).on_hover_text(title).on_hover_cursor(egui::CursorIcon::PointingHand);
+                    let h = theme::anim_bool(&ctx, resp.id.with("h"), resp.hovered(), 0.15);
+                    let sel = app.page == Page::Playlist(id.clone());
+                    let c = Rect::from_center_size(cell.center(), vec2(COVER, COVER)).expand(1.5 * h + 2.0 * lift);
+                    lift_shadow(ui, c, 11.0, lift);
+                    widgets::paint_cover(ui, c, thumbs, 11.0, 1.0);
+                    if sel {
+                        ui.painter().rect_stroke(c.expand(2.0), 13.0, egui::Stroke::new(1.5, theme::text()), egui::StrokeKind::Outside);
+                    }
+                    egui::Popup::context_menu(&resp).show(|ui| {
+                        ui.set_min_width(190.0);
+                        if ui.button("Hide from sidebar").clicked() {
+                            hide = Some(id.clone());
+                            ui.close();
+                        }
+                    });
+                    if resp.clicked() {
+                        open_target = Some(Page::Playlist(id.clone()));
+                    }
+                }
+            });
+    });
+    ctx.data_mut(|d| d.insert_temp(carry_id, carry));
+    // A row let go in a new place: the order is kept (it is saved with the other settings).
+    if let Some(m) = dropped {
+        match m.group {
+            0 => move_item(&mut app.pins, m.from, m.to),
+            1 => move_item(&mut app.pin_songs, m.from, m.to),
+            _ => {
+                // The playlists on show, in their new order, lead the saved order; the ones
+                // that are hidden or pinned keep their places after them.
+                let mut shown: Vec<String> = lists.iter().map(|(id, ..)| id.clone()).collect();
+                move_item(&mut shown, m.from, m.to);
+                app.playlist_order.retain(|id| !shown.contains(id));
+                shown.append(&mut app.playlist_order);
+                app.playlist_order = shown;
+            }
+        }
+    }
+    if let Some(id) = hide {
+        app.hidden_playlists.insert(id);
+    }
+    if let Some(c) = unpin {
+        app.actions.push(Action::TogglePin(c));
+    }
+    if let Some(t) = unpin_song {
+        app.actions.push(Action::TogglePinSong(t));
+    }
+    if let Some(t) = play_song {
+        app.actions.push(Action::Play(vec![t], 0));
+    }
+    if let Some(t) = pin_open {
+        app.actions.push(Action::Open(t));
+    }
+    if let Some(Page::Playlist(id)) = open_target {
+        app.actions.push(Action::Open(crate::model::Target::Playlist(id)));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::move_item;
+
+    #[test]
+    fn a_row_moves_to_its_new_place() {
+        let mut v = vec!["a", "b", "c", "d"];
+        move_item(&mut v, 0, 2);
+        assert_eq!(v, ["b", "c", "a", "d"]);
+        move_item(&mut v, 3, 1);
+        assert_eq!(v, ["b", "d", "c", "a"]);
+        // Nowhere to go, or no change: left alone.
+        move_item(&mut v, 1, 1);
+        move_item(&mut v, 9, 0);
+        assert_eq!(v, ["b", "d", "c", "a"]);
+    }
+}
