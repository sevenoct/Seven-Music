+/// The mark each Settings group carries beside its name.
+fn section_icon(title: &str) -> Option<char> {
+    Some(match title {
+        "Account" => icon::CIRCLE_USER,
+        "Listening" => icon::HEADPHONES,
+        "Listen together" | "Start a party" | "Join with a code" | "People" => icon::USERS,
+        "Playback" | "Party playback" => icon::PLAY,
+        "Equalizer" => icon::LIST_CHECKS,
+        "Hi-res audio" => icon::SPARKLES,
+        "Downloads" => icon::DOWNLOAD,
+        "Lyrics" => icon::MUSIC,
+        "Signature" => icon::CROWN,
+        "Appearance" => icon::SPARKLES,
+        "Player appearance" => icon::DISC_3,
+        "Window" => icon::MAXIMIZE_2,
+        "Discord" | "Discord card" | "Last.fm" => icon::LINK,
+        "Network" => icon::RADIO,
+        "Import" => icon::UPLOAD,
+        "Keyboard shortcuts" => icon::LIST_MUSIC,
+        "About Seven" => icon::HEART,
+        "You" => icon::USER,
+        _ => return None,
+    })
+}
