+/// A faint mirrored copy of the sleeve under its foot, fading out downward: the cover's
+/// reflection. `strength` is its opacity where it starts, 0..1.
+pub fn cover_reflection(ui: &Ui, rect: Rect, thumbs: &[Thumb], px: u32, strength: f32) {
+    if strength <= 0.0 || !ui.is_rect_visible(rect) {
+        return;
+    }
+    let px = fetch_px(px);
+    let Some(t) = pick_thumb(thumbs, px.min(544)) else { return };
+    let uv = t.square_uv();
+    let url = steady_url(ui.ctx(), &t.url, px, true);
+    let Ok(egui::load::TexturePoll::Ready { texture }) = egui::Image::new(url.as_str()).load_for_size(ui.ctx(), rect.size()) else { return };
+    let depth = (rect.height() * 0.32).min(130.0);
+    let ratio = depth / rect.height().max(1.0);
+    const ROWS: usize = 14;
+    let mut mesh = egui::Mesh::with_texture(texture.id);
+    for i in 0..=ROWS {
+        let f = i as f32 / ROWS as f32;
+        let y = rect.bottom() + 3.0 + depth * f;
+        // Mirrored: the further under the sleeve, the higher up its picture.
+        let v = uv.max.y - uv.height() * ratio * f;
+        let a = (strength * (1.0 - f) * (1.0 - f) * 255.0) as u8;
+        let color = Color32::from_white_alpha(a);
+        mesh.vertices.push(egui::epaint::Vertex { pos: pos2(rect.left(), y), uv: pos2(uv.min.x, v), color });
+        mesh.vertices.push(egui::epaint::Vertex { pos: pos2(rect.right(), y), uv: pos2(uv.max.x, v), color });
+        if i > 0 {
+            let k = (i * 2) as u32;
+            mesh.add_triangle(k - 2, k - 1, k);
+            mesh.add_triangle(k - 1, k + 1, k);
+        }
+    }
+    ui.painter().add(egui::Shape::mesh(mesh));
+}
