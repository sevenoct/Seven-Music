+/// The gradient's colours eased toward their target, so a new song's cover melts into the
+/// background over a second or two instead of cutting (the reference clip's soft
+/// colour change). A player that was closed starts on its colours, not on the old song's.
+fn smooth_grid(ctx: &egui::Context, now: f64, target: [Color32; 9]) -> [Color32; 9] {
+    let id = egui::Id::new("np-grid-smooth");
+    let goal: [[f32; 3]; 9] = target.map(|c| [c.r() as f32, c.g() as f32, c.b() as f32]);
+    let (mut cur, last): ([[f32; 3]; 9], f64) = ctx.data(|d| d.get_temp(id)).unwrap_or((goal, now));
+    if now - last > 0.35 {
+        cur = goal;
+    }
+    let dt = ctx.input(|i| i.stable_dt).clamp(0.0, 0.1);
+    // A time constant near 0.8 s: the colours settle in about two seconds.
+    let k = 1.0 - (-dt / 0.8).exp();
+    let mut moving = false;
+    for (c, g) in cur.iter_mut().zip(goal.iter()) {
+        for i in 0..3 {
+            c[i] += (g[i] - c[i]) * k;
+            if (g[i] - c[i]).abs() > 0.4 {
+                moving = true;
+            } else {
+                c[i] = g[i];
+            }
+        }
+    }
+    ctx.data_mut(|d| d.insert_temp(id, (cur, now)));
+    if moving {
+        ctx.request_repaint();
+    }
+    cur.map(|c| Color32::from_rgb(c[0].round() as u8, c[1].round() as u8, c[2].round() as u8))
+}
