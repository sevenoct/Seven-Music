+    /// The sleep timer's clock: counts down (or follows the song to its end), fades the
+    /// volume over the last seconds, then pauses and gives the volume back.
+    fn sleep_tick(&mut self, now: f64) {
+        const FADE: f64 = 8.0;
+        let left = if let Some(end) = self.sleep_end {
+            end - now
+        } else if let Some(id) = &self.sleep_song {
+            if self.playing_id() != Some(id.as_str()) {
+                0.0
+            } else {
+                match self.audio.status.duration() {
+                    Some(d) => d.as_secs_f64() - self.audio.status.position_smooth().as_secs_f64(),
+                    None => return,
+                }
+            }
+        } else {
+            return;
+        };
+        if left <= 0.0 {
+            if self.playing() {
+                self.toggle();
+            }
+            if let Some(v) = self.sleep_vol.take() {
+                self.audio.set_volume(v);
+            }
+            self.sleep_end = None;
+            self.sleep_song = None;
+            self.sleep_pick = None;
+            self.toast("Sleep timer: music stopped");
+        } else if left < FADE {
+            let base = match self.sleep_vol {
+                Some(v) => v,
+                None => {
+                    let v = self.audio.volume();
+                    self.sleep_vol = Some(v);
+                    v
+                }
+            };
+            self.audio.set_volume(base * (left / FADE) as f32);
+        }
+    }
+
+    /// Turns the sleep timer off, giving back the volume if it had begun to fade.
+    pub(super) fn sleep_cancel(&mut self) {
+        if let Some(v) = self.sleep_vol.take() {
+            self.audio.set_volume(v);
+        }
+        self.sleep_end = None;
+        self.sleep_song = None;
+        self.sleep_pick = None;
+    }
+
+    /// Stop the music in `minutes`, or (0) when the song now playing ends.
+    pub(super) fn sleep_set(&mut self, now: f64, minutes: u32) {
+        self.sleep_cancel();
+        self.sleep_pick = Some(minutes);
+        if minutes == 0 {
+            self.sleep_song = self.playing_id().map(str::to_owned);
+            self.toast("Sleep timer: after this song");
+        } else {
+            self.sleep_end = Some(now + minutes as f64 * 60.0);
+            self.toast(format!("Sleep timer: {minutes} minutes"));
+        }
+    }
+
+    /// What the menu says next to the timer while one is set.
+    pub(super) fn sleep_label(&self, now: f64) -> Option<String> {
+        if let Some(end) = self.sleep_end {
+            let s = (end - now).max(0.0).ceil() as u64;
+            Some(if s >= 60 { format!("{} min left", s.div_ceil(60)) } else { format!("{s} s left") })
+        } else {
+            self.sleep_song.as_ref().map(|_| "after this song".to_owned())
+        }
+    }
