+/// The glass's edge: a thin hairline with a soft falloff inside it (three strokes, each
+/// wider and fainter than the last, so the line has no hard cut), and a faint highlight
+/// along the top edge. One function so the rail, the player and the menus share it.
+pub fn rim_shapes(rect: Rect, cr: egui::CornerRadius) -> Vec<egui::Shape> {
+    let radius = cr.nw as f32;
+    let mut out = Vec::with_capacity(4);
+    for (width, alpha) in [(4.0, 4u8), (2.5, 7), (1.0, 17)] {
+        out.push(egui::Shape::rect_stroke(rect, cr, Stroke::new(width, Color32::from_white_alpha(alpha)), egui::StrokeKind::Inside));
