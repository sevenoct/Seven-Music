+    // Each const has its own address, so it doubles as the cache key (with the size).
+    let id = egui::Id::new(("bc-glyph", glyph.as_ptr(), px));
     if let Some(t) = ctx.data(|d| d.get_temp::<TextureHandle>(id)) {
         return Some(t.id());
