diff --git a/src/cache.rs b/src/cache.rs
new file mode 100644
index 0000000..d22cb1e
--- /dev/null
+++ b/src/cache.rs
@@ -0,0 +1,227 @@
+//! What the app keeps on disk to go faster, how big it is, and clearing it.
+//!
+//! Two piles are told apart. The cache is data that can simply be fetched again: music-video
+//! clips, animated artwork, Spotify canvases, thumbnails and the media controls' cover. The
+//! junk is what a download left behind when it didn't finish (`.part` files) and the log of
+//! the run before this one. Nothing else in the data folder is ever touched: settings, the
+//! sign-in, downloads and the user's own icons stay where they are.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+/// Folders (inside the data folder) that hold nothing but what can be fetched again.
+const CACHE_DIRS: &[&str] = &["video", "motion", "canvas", "thumbs", "media-cover"];
+
+/// Files that live inside those folders but are not cache: the canvas index is the app's own
+/// record, not a clip.
+const KEEP: &[&str] = &["index.json"];
+
+/// How much there is of each pile, in bytes.
+#[derive(Clone, Copy, Default, PartialEq, Eq, Debug)]
+pub struct Sizes {
+    pub cache: u64,
+    pub junk: u64,
+    /// Songs downloaded to this device.
+    pub downloads: u64,
+    /// The rest of the app's data folder: settings, the sign-in, the web view's own files.
+    pub other: u64,
+}
+
+impl Sizes {
+    /// Everything Seven keeps on this device.
+    pub fn total(&self) -> u64 {
+        self.cache + self.junk + self.downloads + self.other
+    }
+}
+
+/// Which pile to clear.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Pile {
+    Cache,
+    Junk,
+}
+
+#[derive(Default)]
+struct Shared {
+    sizes: Option<Sizes>,
+    busy: bool,
+    asked: bool,
+}
+
+/// The app's handle on its own disk use. Measuring and clearing run on a thread of their own,
+/// so a gigabyte of clips never holds up a frame.
+#[derive(Clone, Default)]
+pub struct Storage {
+    shared: Arc<Mutex<Shared>>,
+}
+
+impl Storage {
+    /// The last measurement, if there is one yet.
+    pub fn sizes(&self) -> Option<Sizes> {
+        self.shared.lock().ok()?.sizes
+    }
+
+    /// Whether a measurement or a clearing is running.
+    pub fn busy(&self) -> bool {
+        self.shared.lock().map_or(false, |s| s.busy)
+    }
+
+    /// Measure once, the first time the settings page asks.
+    pub fn ensure(&self, ctx: &egui::Context) {
+        let first = match self.shared.lock() {
+            Ok(mut s) => !std::mem::replace(&mut s.asked, true),
+            Err(_) => false,
+        };
+        if first {
+            self.run(ctx, None);
+        }
+    }
+
+    /// Measure again.
+    #[allow(dead_code)]
+    pub fn refresh(&self, ctx: &egui::Context) {
+        self.run(ctx, None);
+    }
+
+    /// Delete one pile, then measure again.
+    pub fn clear(&self, ctx: &egui::Context, pile: Pile) {
+        self.run(ctx, Some(pile));
+    }
+
+    fn run(&self, ctx: &egui::Context, clear: Option<Pile>) {
+        {
+            let Ok(mut s) = self.shared.lock() else { return };
+            if s.busy {
+                return;
+            }
+            s.busy = true;
+        }
+        let (shared, ctx) = (self.shared.clone(), ctx.clone());
+        let spawned = std::thread::Builder::new().name("storage".into()).spawn(move || {
+            let root = crate::data_dir();
+            if let Some(pile) = clear {
+                remove(&root, pile);
+            }
+            let sizes = measure(&root);
+            if let Ok(mut s) = shared.lock() {
+                s.sizes = Some(sizes);
+                s.busy = false;
+            }
+            ctx.request_repaint();
+        });
+        if spawned.is_err()
+            && let Ok(mut s) = self.shared.lock()
+        {
+            s.busy = false;
+        }
+    }
+}
+
+/// Every file in the cache folders, and the previous run's log, with its size.
+fn listing(root: &Path) -> Vec<(PathBuf, u64)> {
+    fn walk(dir: &Path, out: &mut Vec<(PathBuf, u64)>) {
+        let Ok(entries) = std::fs::read_dir(dir) else { return };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            match entry.metadata() {
+                Ok(m) if m.is_dir() => walk(&path, out),
+                Ok(m) => out.push((path, m.len())),
+                Err(_) => {}
+            }
+        }
+    }
+    let mut out = Vec::new();
+    for dir in CACHE_DIRS {
+        walk(&root.join(dir), &mut out);
+    }
+    if let Ok(m) = std::fs::metadata(root.join("ytm-rs.prev.log")) {
+        out.push((root.join("ytm-rs.prev.log"), m.len()));
+    }
+    out
+}
+
+/// Which pile a file belongs to, or neither.
+fn pile_of(path: &Path) -> Option<Pile> {
+    let name = path.file_name()?.to_string_lossy();
+    if name == "ytm-rs.prev.log" || path.extension().is_some_and(|e| e == "part") {
+        return Some(Pile::Junk);
+    }
+    if KEEP.iter().any(|k| name == *k) {
+        return None;
+    }
+    Some(Pile::Cache)
+}
+
+fn measure(root: &Path) -> Sizes {
+    let mut sizes = Sizes::default();
+    for (path, len) in listing(root) {
+        match pile_of(&path) {
+            Some(Pile::Cache) => sizes.cache += len,
+            Some(Pile::Junk) => sizes.junk += len,
+            None => {}
+        }
+    }
+    sizes.downloads = crate::downloads::disk_size();
+    // Whatever else sits in the data folder (the canvas index counts here too).
+    sizes.other = dir_size(root).saturating_sub(sizes.cache + sizes.junk);
+    sizes
+}
+
+/// Every file under `dir`, added up.
+fn dir_size(dir: &Path) -> u64 {
+    let Ok(entries) = std::fs::read_dir(dir) else { return 0 };
+    entries
+        .flatten()
+        .map(|e| match e.metadata() {
+            Ok(m) if m.is_dir() => dir_size(&e.path()),
+            Ok(m) => m.len(),
+            Err(_) => 0,
+        })
+        .sum()
+}
+
+/// A file something is using (a clip that is playing) refuses to go; it stays, and the next
+/// clearing gets it.
+fn remove(root: &Path, pile: Pile) {
+    for (path, _) in listing(root) {
+        if pile_of(&path) == Some(pile) {
+            let _ = std::fs::remove_file(&path);
+        }
+    }
+}
+
+/// `1.4 GB`, `230 MB`, `12 KB`.
+pub fn fmt(bytes: u64) -> String {
+    const KB: f64 = 1024.0;
+    let b = bytes as f64;
+    if b >= KB * KB * KB {
+        format!("{:.1} GB", b / (KB * KB * KB))
+    } else if b >= KB * KB {
+        format!("{:.0} MB", b / (KB * KB))
+    } else if b >= KB {
+        format!("{:.0} KB", b / KB)
+    } else {
+        format!("{bytes} B")
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn leftovers_are_junk_and_the_index_is_kept() {
+        assert_eq!(pile_of(Path::new("video/abc.part")), Some(Pile::Junk));
+        assert_eq!(pile_of(Path::new("ytm-rs.prev.log")), Some(Pile::Junk));
+        assert_eq!(pile_of(Path::new("video/abc.mp4")), Some(Pile::Cache));
+        assert_eq!(pile_of(Path::new("canvas/index.json")), None);
+    }
+
+    #[test]
+    fn sizes_read_plainly() {
+        assert_eq!(fmt(512), "512 B");
+        assert_eq!(fmt(2048), "2 KB");
+        assert_eq!(fmt(5 * 1024 * 1024), "5 MB");
+        assert_eq!(fmt(3 * 1024 * 1024 * 1024), "3.0 GB");
+    }
+}
