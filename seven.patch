+impl App {
+    /// Opens the full player once the pointer and keyboard have rested for `idle_open`
+    /// seconds, on any page, while a song plays. Not in the mini player, in the tray,
+    /// when the window isn't the one in use, or while a text box has the keyboard. The
+    /// rest is counted from the last activity, and from the moment the player closes.
+    /// "Frame rate limit": when frames come faster than the ceiling, wait out the rest of
+    /// the frame's time before starting the next. It paces every animation at once, whatever
+    /// asked for the repaint. Frames already further apart than that (an idle app) aren't
+    /// touched, and a hidden window isn't paced at all.
+    fn limit_fps(&mut self) {
+        if self.fps_cap == 0 || self.window.hidden() {
+            self.fps_frame_start = None;
+            return;
+        }
+        let period = Duration::from_secs_f64(1.0 / f64::from(self.fps_cap));
+        if let Some(prev) = self.fps_frame_start {
+            let spent = prev.elapsed();
+            // A millisecond short of the period: the sleep overshoots a little, and the
+            // screen's own vsync supplies the rest.
+            if spent + Duration::from_millis(2) < period {
+                std::thread::sleep(period - spent - Duration::from_millis(1));
+            }
+        }
+        self.fps_frame_start = Some(std::time::Instant::now());
+    }
