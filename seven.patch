+/// The listener's wall clock as seconds since 1970-01-01 (local time read as if it were UTC).
+pub fn local_secs() -> i64 {
+    let secs = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64);
+    // The clocks ask every frame; the zone only changes by travel or daylight saving, so the
+    // system is asked again at most every half minute.
+    static ZONE: std::sync::Mutex<Option<(std::time::Instant, i32)>> = std::sync::Mutex::new(None);
+    let offset = match ZONE.lock() {
+        Ok(mut z) => match *z {
+            Some((at, m)) if at.elapsed() < std::time::Duration::from_secs(30) => m,
+            _ => {
+                let m = utc_offset_minutes();
+                *z = Some((std::time::Instant::now(), m));
+                m
+            }
+        },
+        Err(_) => utc_offset_minutes(),
+    };
+    secs + offset as i64 * 60
+}
